---
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { withBase } from '@utils/base';
import { parseBibtex } from '@utils/bibtex';
import { publicationCount } from '@utils/people';
import { getCollection } from 'astro:content';

import bibRaw from '../../data/papers.bib?raw';

const all = await getCollection('people');
const bibEntries = parseBibtex(bibRaw);

/** Profile page href, or undefined when the person opted out of having one. */
const profileHref = (person: (typeof all)[number]): string | undefined =>
  person.data.noPage ? undefined : `${site.base}/people/${person.id}/`;
const current = all
  .filter((p) => p.data.group === 'current')
  .sort((a, b) => (a.data.importance ?? 999) - (b.data.importance ?? 999));
const alumni = all
  .filter((p) => p.data.group === 'alumni')
  .sort((a, b) => (a.data.importance ?? 999) - (b.data.importance ?? 999));

// Lab hierarchy: the head(s) — PI / director / faculty — are featured in a
// prominent card on top; everyone else sits in the grid below. Falls back to
// the highest-ranked current member if no role matches.
const leadRe = /principal investigator|director|professor|faculty|advisor|\bpi\b/i;
let leads = current.filter((p) => leadRe.test(p.data.role));
if (leads.length === 0 && current.length > 0) leads = [current[0]];
const leadIds = new Set(leads.map((p) => p.id));
const members = current.filter((p) => !leadIds.has(p.id));

// Split a role on "·" so the first segment reads as a title eyebrow.
const splitRole = (role: string) => {
  const parts = role.split('·').map((s) => s.trim());
  return { lead: parts[0], rest: parts.slice(1).join(' · ') };
};
---

<Page title="People" description={`Research group members of ${site.author.name}`}>
  <header class="post-header" data-reveal>
    <h1 class="post-title">People</h1>
    <p class="post-description" style="color: var(--global-text-color-light);">
      Meet the researchers behind Convergence Design Lab.
    </p>
  </header>

  {
    all.length > 0 && (
      <div class="people-search" data-reveal>
        <input
          type="text"
          id="people-search-input"
          placeholder="Search people by name or role…"
          aria-label="Search people"
          autocomplete="off"
        />
        <p id="people-search-empty" class="people-search-empty" hidden>
          No people match your search.
        </p>
      </div>
    )
  }

  {
    current.length > 0 && (
      <section class="mb-10" data-reveal>
        <h2
          class="mb-6 text-xl font-bold"
          style="color: var(--global-theme-color); border-bottom: 1px solid var(--global-divider-color); padding-bottom: 0.25rem;"
        >
          Current Members
        </h2>

        {/* ── Featured head(s) of the lab ─────────────────────────────── */}
        <div class="lead-grid">
          {leads.map((person) => {
            const href = profileHref(person);
            const pubs = publicationCount(person.data.name, bibEntries, person.data.aliases);
            const role = splitRole(person.data.role);
            return (
              <div class="lead-card" data-reveal>
                <div class="lead-avatar">
                  {person.data.photo ? (
                    <img
                      src={withBase(person.data.photo)}
                      alt={person.data.name}
                      loading="eager"
                      width="150"
                      height="150"
                    />
                  ) : (
                    <div class="avatar-fallback" aria-hidden="true">
                      {person.data.name.charAt(0)}
                    </div>
                  )}
                  {pubs > 0 && (
                    <span class="pub-badge" title={`${pubs} publications`}>
                      {pubs}
                    </span>
                  )}
                </div>
                <div class="lead-info">
                  <p class="lead-eyebrow">{role.lead}</p>
                  <h3 class="lead-name">
                    {href ? (
                      <a href={href}>{person.data.name}</a>
                    ) : person.data.website ? (
                      <a href={person.data.website} target="_blank" rel="noopener noreferrer">
                        {person.data.name}
                      </a>
                    ) : (
                      person.data.name
                    )}
                  </h3>
                  {role.rest && <p class="lead-role">{role.rest}</p>}
                  {person.data.description && <p class="lead-desc">{person.data.description}</p>}
                  <div class="lead-links">
                    {href && (
                      <a class="lead-link primary" href={href}>
                        View profile →
                      </a>
                    )}
                    {person.data.website && (
                      <a href={person.data.website} target="_blank" rel="noopener noreferrer">
                        Website
                      </a>
                    )}
                    {person.data.scholar && (
                      <a
                        href={`https://scholar.google.com/citations?user=${person.data.scholar}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Scholar
                      </a>
                    )}
                    {person.data.github && (
                      <a
                        href={`https://github.com/${person.data.github}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        GitHub
                      </a>
                    )}
                    {person.data.email && <a href={`mailto:${person.data.email}`}>Email</a>}
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {members.map((person, i) => {
            const href = profileHref(person);
            const pubs = publicationCount(person.data.name, bibEntries, person.data.aliases);
            return (
              <div
                class="person-card text-center"
                data-reveal
                style={`--reveal-delay: ${i * 0.04}s`}
              >
                <div class="avatar-wrap">
                  {person.data.photo ? (
                    <img
                      src={withBase(person.data.photo)}
                      alt={person.data.name}
                      loading="lazy"
                      width="120"
                      height="120"
                    />
                  ) : (
                    <div class="avatar-fallback" aria-hidden="true">
                      {person.data.name.charAt(0)}
                    </div>
                  )}
                  {pubs > 0 && (
                    <span class="pub-badge" title={`${pubs} publications`}>
                      {pubs}
                    </span>
                  )}
                </div>

                <h3 class="person-name">
                  {href ? (
                    <a href={href}>{person.data.name}</a>
                  ) : person.data.website ? (
                    <a href={person.data.website} target="_blank" rel="noopener noreferrer">
                      {person.data.name}
                    </a>
                  ) : (
                    person.data.name
                  )}
                </h3>
                <p class="person-role">{person.data.role}</p>

                {/* Social icons */}
                <div class="mt-1 flex justify-center gap-2">
                  {person.data.github && (
                    <a
                      href={`https://github.com/${person.data.github}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="social-mini"
                      aria-label={`${person.data.name} on GitHub`}
                    >
                      gh
                    </a>
                  )}
                  {person.data.scholar && (
                    <a
                      href={`https://scholar.google.com/citations?user=${person.data.scholar}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="social-mini"
                      aria-label={`${person.data.name} on Google Scholar`}
                    >
                      gs
                    </a>
                  )}
                </div>

                {person.data.description && <p class="person-desc">{person.data.description}</p>}
              </div>
            );
          })}
        </div>
      </section>
    )
  }

  {
    alumni.length > 0 && (
      <section class="mb-10" data-reveal>
        <h2
          class="mb-6 text-xl font-bold"
          style="color: var(--global-theme-color); border-bottom: 1px solid var(--global-divider-color); padding-bottom: 0.25rem;"
        >
          Alumni
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
          {alumni.map((person) => {
            const href = profileHref(person);
            return (
              <div class="alumni-row flex items-center gap-3">
                {person.data.photo && (
                  <img
                    src={withBase(person.data.photo)}
                    alt={person.data.name}
                    loading="lazy"
                    width="48"
                    height="48"
                    style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover; flex-shrink: 0;"
                  />
                )}
                <div>
                  <p class="person-name text-sm">
                    {href ? (
                      <a href={href}>{person.data.name}</a>
                    ) : person.data.website ? (
                      <a href={person.data.website} target="_blank" rel="noopener noreferrer">
                        {person.data.name}
                      </a>
                    ) : (
                      person.data.name
                    )}
                  </p>
                  <p class="person-role">{person.data.role}</p>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )
  }

  {all.length === 0 && <p style="color: var(--global-text-color-light);">No people entries yet.</p>}
</Page>

<script>
  function initPeopleSearch() {
    const input = document.getElementById('people-search-input') as HTMLInputElement | null;
    const empty = document.getElementById('people-search-empty') as HTMLElement | null;
    if (!input) return;

    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.lead-card, .person-card, .alumni-row'),
    );
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section.mb-10'));

    function apply() {
      const q = input!.value.trim().toLowerCase();
      let anyVisible = false;

      cards.forEach((card) => {
        const match = q === '' || (card.textContent ?? '').toLowerCase().includes(q);
        card.style.display = match ? '' : 'none';
        if (match) anyVisible = true;
      });

      // Hide a whole section (heading + grid) when none of its people match.
      sections.forEach((section) => {
        const visible = section.querySelector(
          '.lead-card:not([style*="display: none"]), .person-card:not([style*="display: none"]), .alumni-row:not([style*="display: none"])',
        );
        section.style.display = visible ? '' : 'none';
      });

      if (empty) empty.hidden = anyVisible;
    }

    input.addEventListener('input', apply);
  }

  document.addEventListener('astro:page-load', initPeopleSearch);
</script>

<style>
  .people-search {
    margin: 1.25rem 0 2rem;
  }

  #people-search-input {
    width: 100%;
    padding: 0.7rem 1rem;
    font-size: 1rem;
    border-radius: 10px;
    border: 1px solid var(--global-divider-color);
    background: var(--global-bg-color);
    color: var(--global-text-color);
    transition: border-color 0.15s ease;
  }

  #people-search-input:focus {
    outline: none;
    border-color: var(--global-theme-color);
  }

  .people-search-empty {
    margin: 0.5rem 0 0;
    color: var(--global-text-color-light);
    font-style: italic;
  }

  h2,
  .person-name,
  .pub-badge,
  .lead-name,
  .lead-eyebrow {
    font-family: 'Space Grotesk', system-ui, sans-serif;
  }

  /* ── Featured lab head(s) ───────────────────────────────────────────── */

  .lead-grid {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 900px) {
    .lead-grid:has(.lead-card:nth-child(2)) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lead-card {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding: 1.75rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 16px;
    background: var(--global-card-bg-color);
    position: relative;
    overflow: hidden;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* Gold accent rail on the leading edge */
  .lead-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(
      to bottom,
      var(--global-theme-color),
      color-mix(in srgb, var(--global-theme-color) 20%, transparent)
    );
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lead-card:hover {
    transform: translateY(-4px);
    border-color: var(--global-theme-color);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
  }

  html[data-theme='dark'] .lead-card:hover {
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
  }

  .lead-card:hover::before {
    transform: scaleY(1);
  }

  .lead-avatar {
    position: relative;
    flex: 0 0 auto;
  }

  .lead-avatar img,
  .lead-avatar .avatar-fallback {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .lead-card:hover .lead-avatar img,
  .lead-card:hover .lead-avatar .avatar-fallback {
    transform: scale(1.03);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--global-theme-color) 32%, transparent);
  }

  .lead-avatar .avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--global-bg-color);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--color-silver);
  }

  .lead-info {
    min-width: 0;
  }

  .lead-eyebrow {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--global-theme-color);
    margin: 0 0 0.35rem;
  }

  .lead-name {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 0.3rem;
  }

  .lead-name a {
    color: var(--global-text-color);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lead-name a:hover {
    color: var(--global-theme-color);
  }

  .lead-role {
    font-size: 0.85rem;
    color: var(--global-text-color-light);
    margin: 0 0 0.6rem;
    line-height: 1.4;
  }

  .lead-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--global-text-color-light);
    margin: 0 0 0.85rem;
    max-width: 52ch;
  }

  .lead-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .lead-links a {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--global-text-color);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--global-divider-color);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .lead-links a:hover {
    color: var(--global-theme-color);
    border-color: var(--global-theme-color);
  }

  .lead-links a.primary {
    color: var(--global-theme-color);
    border-color: color-mix(in srgb, var(--global-theme-color) 50%, transparent);
  }

  @media (max-width: 640px) {
    .lead-card {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
      padding: 1.5rem 1.25rem;
    }
    .lead-links {
      justify-content: center;
    }
    .lead-avatar img,
    .lead-avatar .avatar-fallback {
      width: 128px;
      height: 128px;
    }
  }

  .person-card {
    padding: 1.75rem 1.25rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 16px;
    background: var(--global-card-bg-color);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .person-card:hover {
    border-color: var(--global-theme-color);
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.1);
  }

  html[data-theme='dark'] .person-card:hover {
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.45);
  }

  /* ── Avatar + publication badge ─────────────────────────────────────── */

  .avatar-wrap {
    position: relative;
    width: 120px;
    margin: 0 auto 0.75rem;
  }

  .person-card img,
  .person-card .avatar-fallback {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .person-card .avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--global-bg-color);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-silver);
  }

  .person-card:hover img,
  .person-card:hover .avatar-fallback {
    box-shadow:
      0 0 0 3px var(--global-bg-color),
      0 0 0 5px var(--color-silver);
    transform: scale(1.03);
  }

  .pub-badge {
    position: absolute;
    right: 2px;
    bottom: 2px;
    min-width: 24px;
    height: 24px;
    padding: 0 5px;
    border-radius: 12px;
    background: var(--global-bg-color);
    border: 1px solid var(--color-silver);
    color: var(--color-silver-dark);
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 22px;
    font-variant-numeric: tabular-nums;
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .person-card:hover .pub-badge {
    background: var(--color-silver);
    color: var(--global-bg-color);
  }

  /* ── Text ───────────────────────────────────────────────────────────── */

  .person-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--global-text-color);
  }

  .person-name a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--color-silver), var(--color-silver));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.25s ease;
  }

  .person-name a:hover {
    background-size: 100% 1px;
  }

  .person-role {
    margin-top: 0.15rem;
    font-size: 0.75rem;
    color: var(--global-text-color-light);
  }

  .person-desc {
    margin-top: 0.35rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--color-silver-dark);
  }

  .social-mini {
    font-size: 0.7rem;
    color: var(--color-silver-dark);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-mini:hover {
    color: var(--global-text-color);
  }

  .alumni-row {
    padding: 0.4rem;
    border-radius: 8px;
    transition: background-color 0.2s ease;
  }

  .alumni-row:hover {
    background-color: var(--global-card-bg-color);
  }

  /* People reveal as a clean rise + fade — NO blur anywhere on this page. */
  :global(html.js-reveal) [data-reveal] {
    filter: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .person-card,
    .person-card img,
    .person-card .avatar-fallback,
    .person-name a,
    .pub-badge,
    .lead-card,
    .lead-card::before,
    .lead-avatar img,
    .lead-avatar .avatar-fallback {
      transition: none !important;
    }
    .person-card:hover,
    .lead-card:hover,
    .lead-card:hover .lead-avatar img,
    .lead-card:hover .lead-avatar .avatar-fallback {
      transform: none;
    }
    .lead-card:hover::before {
      transform: scaleY(0);
    }
  }
</style>

---
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { withBase } from '@utils/base';
import { parseBibtex } from '@utils/bibtex';
import { publicationCount } from '@utils/people';
import { getCollection } from 'astro:content';

import bibRaw from '../../data/papers.bib?raw';

const all = await getCollection('people');
const bibEntries = parseBibtex(bibRaw);

/** Profile page href, or undefined when the person opted out of having one. */
const profileHref = (person: (typeof all)[number]): string | undefined =>
  person.data.noPage ? undefined : `${site.base}/people/${person.id}/`;
const current = all
  .filter((p) => p.data.group === 'current')
  .sort((a, b) => (a.data.importance ?? 999) - (b.data.importance ?? 999));
const alumni = all
  .filter((p) => p.data.group === 'alumni')
  .sort((a, b) => (a.data.importance ?? 999) - (b.data.importance ?? 999));

// Lab hierarchy: the head(s) — PI / director / faculty — are featured in a
// prominent card on top; everyone else sits in the grid below. Falls back to
// the highest-ranked current member if no role matches.
const leadRe = /principal investigator|director|professor|faculty|advisor|\bpi\b/i;
let leads = current.filter((p) => leadRe.test(p.data.role));
if (leads.length === 0 && current.length > 0) leads = [current[0]];
const leadIds = new Set(leads.map((p) => p.id));
const members = current.filter((p) => !leadIds.has(p.id));

// Undergraduates get their own block under a rule, so the graduate roster above
// stays a like-for-like list. `members` still holds both, because the
// click-to-open popup data is built from it.
const gradMembers = members.filter((p) => p.data.tier !== 'undergrad');
const undergradMembers = members.filter((p) => p.data.tier === 'undergrad');

const rosterBlocks = [
  { heading: null as string | null, list: gradMembers },
  { heading: 'Undergraduate Researchers', list: undergradMembers },
].filter((b) => b.list.length > 0);

// Split a role on "·" so the first segment reads as a title eyebrow.
const splitRole = (role: string) => {
  const parts = role.split('·').map((s) => s.trim());
  return { lead: parts[0], rest: parts.slice(1).join(' · ') };
};

// ── Popup data ────────────────────────────────────────────────────────────
// Clicking a member card opens a modal with their details (built client-side
// from this map), so visitors never leave the page to see who does what.
const allProjectsForModal = await getCollection('projects');
const normM = (s: string) => s.trim().toLowerCase();
const resolveProjects = (person: (typeof members)[number]) => {
  const wantSlugs = new Set(person.data.projects.map(normM));
  const wantInts = new Set(person.data.interests.map(normM));
  return allProjectsForModal
    .filter(
      (p) =>
        wantSlugs.has(normM(p.id)) ||
        wantSlugs.has(normM(p.data.title)) ||
        wantInts.has(normM(p.data.title)),
    )
    .sort((a, b) => (a.data.importance ?? 999) - (b.data.importance ?? 999))
    .map((p) => ({ title: p.data.title, href: `${site.base}/projects/${p.id}/` }));
};
const modalData = Object.fromEntries(
  members.map((person) => [
    person.id,
    {
      name: person.data.name,
      role: person.data.role,
      photo: person.data.photo ? withBase(person.data.photo) : null,
      initial: person.data.name.charAt(0),
      description: person.data.description ?? '',
      projects: resolveProjects(person),
      email: person.data.email ?? null,
      website: person.data.website ?? null,
      scholar: person.data.scholar
        ? `https://scholar.google.com/citations?user=${person.data.scholar}`
        : null,
      github: person.data.github ? `https://github.com/${person.data.github}` : null,
      pubs: publicationCount(person.data.name, bibEntries, person.data.aliases),
      href: profileHref(person) ?? null,
    },
  ]),
);
---

<Page title="People" description={`Research group members of ${site.author.name}`}>
  <header class="post-header" data-reveal>
    <h1 class="post-title">People</h1>
    <p class="post-description" style="color: var(--global-text-color-light);">
      Meet the researchers behind Convergence Design Lab.
    </p>
  </header>

  {
    all.length > 0 && (
      <div class="people-search" data-reveal>
        <input
          type="text"
          id="people-search-input"
          placeholder="Search people by name or role…"
          aria-label="Search people"
          autocomplete="off"
        />
        <p id="people-search-empty" class="people-search-empty" hidden>
          No people match your search.
        </p>
      </div>
    )
  }

  {
    current.length > 0 && (
      <section class="mb-10" data-reveal>
        <h2
          class="mb-6 text-xl font-bold"
          style="color: var(--global-theme-color); border-bottom: 1px solid var(--global-divider-color); padding-bottom: 0.25rem;"
        >
          Current Members
        </h2>

        {/* ── Featured head(s) of the lab ─────────────────────────────── */}
        <div class="lead-grid">
          {leads.map((person) => {
            const href = profileHref(person);
            const pubs = publicationCount(person.data.name, bibEntries, person.data.aliases);
            const role = splitRole(person.data.role);
            return (
              <div class="lead-card" data-reveal>
                <div class="lead-avatar">
                  {person.data.photo ? (
                    <img
                      src={withBase(person.data.photo)}
                      alt={person.data.name}
                      loading="eager"
                      width="150"
                      height="150"
                    />
                  ) : (
                    <div class="avatar-fallback" aria-hidden="true">
                      {person.data.name.charAt(0)}
                    </div>
                  )}
                  {pubs > 0 && (
                    <span class="pub-badge" title={`${pubs} publications`}>
                      {pubs}
                    </span>
                  )}
                </div>
                <div class="lead-info">
                  <p class="lead-eyebrow">{role.lead}</p>
                  <h3 class="lead-name">
                    {href ? (
                      <a href={href}>{person.data.name}</a>
                    ) : person.data.website ? (
                      <a href={person.data.website} target="_blank" rel="noopener noreferrer">
                        {person.data.name}
                      </a>
                    ) : (
                      person.data.name
                    )}
                  </h3>
                  {role.rest && <p class="lead-role">{role.rest}</p>}
                  {person.data.description && <p class="lead-desc">{person.data.description}</p>}
                  <div class="lead-links">
                    {href && (
                      <a class="lead-link primary" href={href}>
                        View profile →
                      </a>
                    )}
                    {person.data.website && (
                      <a href={person.data.website} target="_blank" rel="noopener noreferrer">
                        Website
                      </a>
                    )}
                    {person.data.scholar && (
                      <a
                        href={`https://scholar.google.com/citations?user=${person.data.scholar}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Scholar
                      </a>
                    )}
                    {person.data.github && (
                      <a
                        href={`https://github.com/${person.data.github}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        GitHub
                      </a>
                    )}
                    {person.data.email && <a href={`mailto:${person.data.email}`}>Email</a>}
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        {/*
          Two blocks from one copy of the card markup: graduate researchers, then
          undergraduates under a rule. A block with nobody in it renders nothing,
          so the undergraduate heading only appears once someone is listed.
        */}
        {rosterBlocks.map((block) => (
          <Fragment>
            {block.heading && (
              <h3 class="roster-divider">
                {block.heading}
                <span class="roster-count">{block.list.length}</span>
              </h3>
            )}
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {block.list.map((person, i) => {
                const pubs = publicationCount(person.data.name, bibEntries, person.data.aliases);
                return (
                  <div
                    class="person-card text-center"
                    data-reveal
                    data-person-id={person.id}
                    role="button"
                    tabindex="0"
                    aria-haspopup="dialog"
                    aria-label={`View details for ${person.data.name}`}
                    style={`--reveal-delay: ${i * 0.04}s`}
                  >
                    <div class="avatar-wrap">
                      {person.data.photo ? (
                        <img
                          src={withBase(person.data.photo)}
                          alt={person.data.name}
                          loading="lazy"
                          width="120"
                          height="120"
                        />
                      ) : (
                        <div class="avatar-fallback" aria-hidden="true">
                          {person.data.name.charAt(0)}
                        </div>
                      )}
                      {pubs > 0 && (
                        <span class="pub-badge" title={`${pubs} publications`}>
                          {pubs}
                        </span>
                      )}
                    </div>

                    <h3 class="person-name">{person.data.name}</h3>
                    <p class="person-role">
                      {person.data.role}
                      {person.data.major && (
                        <span class="person-field"> · {person.data.major}</span>
                      )}
                    </p>
                    <span class="person-cta" aria-hidden="true">
                      View details →
                    </span>
                  </div>
                );
              })}
            </div>
          </Fragment>
        ))}
      </section>
    )
  }

  {
    alumni.length > 0 && (
      <section class="mb-10" data-reveal>
        <h2
          class="mb-6 text-xl font-bold"
          style="color: var(--global-theme-color); border-bottom: 1px solid var(--global-divider-color); padding-bottom: 0.25rem;"
        >
          Alumni
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
          {alumni.map((person) => {
            const href = profileHref(person);
            return (
              <div class="alumni-row flex items-center gap-3">
                {person.data.photo && (
                  <img
                    src={withBase(person.data.photo)}
                    alt={person.data.name}
                    loading="lazy"
                    width="48"
                    height="48"
                    style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover; flex-shrink: 0;"
                  />
                )}
                <div>
                  <p class="person-name text-sm">
                    {href ? (
                      <a href={href}>{person.data.name}</a>
                    ) : person.data.website ? (
                      <a href={person.data.website} target="_blank" rel="noopener noreferrer">
                        {person.data.name}
                      </a>
                    ) : (
                      person.data.name
                    )}
                  </p>
                  <p class="person-role">{person.data.role}</p>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )
  }

  {all.length === 0 && <p style="color: var(--global-text-color-light);">No people entries yet.</p>}

  {/* ── Member detail popup ─────────────────────────────────────────────── */}
  <div
    class="person-modal"
    id="person-modal"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="pm-name"
  >
    <div class="person-modal-backdrop" data-modal-close></div>
    <div class="person-modal-card" role="document">
      <button type="button" class="person-modal-close" data-modal-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6L6 18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <div class="pm-head">
        <div class="pm-avatar">
          <img id="pm-photo" alt="" width="96" height="96" hidden />
          <span id="pm-initial" class="pm-initial" aria-hidden="true" hidden></span>
          <span id="pm-badge" class="pm-badge" hidden></span>
        </div>
        <div class="pm-headtext">
          <h2 class="pm-name" id="pm-name"></h2>
          <p class="pm-role" id="pm-role"></p>
        </div>
      </div>
      <p class="pm-desc" id="pm-desc" hidden></p>
      <div class="pm-block" id="pm-projects-wrap" hidden>
        <p class="pm-label">Research areas</p>
        <div class="pm-projects" id="pm-projects"></div>
      </div>
      <div class="pm-links" id="pm-links"></div>
    </div>
  </div>

  <script type="application/json" id="people-modal-data" set:html={JSON.stringify(modalData)} />
</Page>

<script>
  function initPeopleSearch() {
    const input = document.getElementById('people-search-input') as HTMLInputElement | null;
    const empty = document.getElementById('people-search-empty') as HTMLElement | null;
    if (!input) return;

    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.lead-card, .person-card, .alumni-row'),
    );
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section.mb-10'));

    function apply() {
      const q = input!.value.trim().toLowerCase();
      let anyVisible = false;

      cards.forEach((card) => {
        const match = q === '' || (card.textContent ?? '').toLowerCase().includes(q);
        card.style.display = match ? '' : 'none';
        if (match) anyVisible = true;
      });

      // Hide a whole section (heading + grid) when none of its people match.
      sections.forEach((section) => {
        const visible = section.querySelector(
          '.lead-card:not([style*="display: none"]), .person-card:not([style*="display: none"]), .alumni-row:not([style*="display: none"])',
        );
        section.style.display = visible ? '' : 'none';
      });

      if (empty) empty.hidden = anyVisible;
    }

    input.addEventListener('input', apply);
  }

  // Clicking a member card (photo included) opens a popup with their details —
  // no page navigation. Data is embedded as JSON at build time.
  type PMProject = { title: string; href: string };
  type PMPerson = {
    name: string;
    role: string;
    photo: string | null;
    initial: string;
    description: string;
    projects: PMProject[];
    email: string | null;
    website: string | null;
    scholar: string | null;
    github: string | null;
    pubs: number;
    href: string | null;
  };

  function initPeopleModal() {
    const dataEl = document.getElementById('people-modal-data');
    const modal = document.getElementById('person-modal');
    if (!dataEl || !modal) return;

    let data: Record<string, PMPerson> = {};
    try {
      data = JSON.parse(dataEl.textContent || '{}');
    } catch {
      return;
    }

    const photo = document.getElementById('pm-photo') as HTMLImageElement | null;
    const initial = document.getElementById('pm-initial');
    const badge = document.getElementById('pm-badge');
    const nameEl = document.getElementById('pm-name');
    const roleEl = document.getElementById('pm-role');
    const descEl = document.getElementById('pm-desc');
    const projWrap = document.getElementById('pm-projects-wrap');
    const projEl = document.getElementById('pm-projects');
    const linksEl = document.getElementById('pm-links');
    if (
      !photo ||
      !initial ||
      !badge ||
      !nameEl ||
      !roleEl ||
      !descEl ||
      !projWrap ||
      !projEl ||
      !linksEl
    )
      return;

    let lastFocus: HTMLElement | null = null;

    const makeLink = (href: string, label: string, external: boolean, primary = false) => {
      const a = document.createElement('a');
      a.href = href;
      a.textContent = label;
      a.className = 'pm-link' + (primary ? ' primary' : '');
      if (external) {
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      }
      return a;
    };

    const open = (id: string) => {
      const p = data[id];
      if (!p) return;

      if (p.photo) {
        photo.src = p.photo;
        photo.alt = p.name;
        photo.hidden = false;
        initial.hidden = true;
      } else {
        initial.textContent = p.initial;
        initial.hidden = false;
        photo.hidden = true;
      }
      if (p.pubs > 0) {
        badge.textContent = String(p.pubs);
        badge.title = `${p.pubs} publications`;
        badge.hidden = false;
      } else {
        badge.hidden = true;
      }

      nameEl.textContent = p.name;
      roleEl.textContent = p.role;

      if (p.description) {
        descEl.textContent = p.description;
        descEl.hidden = false;
      } else {
        descEl.hidden = true;
      }

      projEl.textContent = '';
      if (p.projects.length) {
        p.projects.forEach((pr) => {
          const a = document.createElement('a');
          a.href = pr.href;
          a.textContent = pr.title;
          a.className = 'pm-chip';
          projEl.appendChild(a);
        });
        projWrap.hidden = false;
      } else {
        projWrap.hidden = true;
      }

      linksEl.textContent = '';
      if (p.href) linksEl.appendChild(makeLink(p.href, 'Full profile →', false, true));
      if (p.website) linksEl.appendChild(makeLink(p.website, 'Website', true));
      if (p.scholar) linksEl.appendChild(makeLink(p.scholar, 'Scholar', true));
      if (p.github) linksEl.appendChild(makeLink(p.github, 'GitHub', true));
      if (p.email) linksEl.appendChild(makeLink(`mailto:${p.email}`, 'Email', false));

      lastFocus = document.activeElement as HTMLElement;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => modal.classList.add('open'));
      modal.querySelector<HTMLElement>('.person-modal-close')?.focus();
    };

    const close = () => {
      modal.classList.remove('open');
      document.body.style.overflow = '';
      window.setTimeout(() => {
        if (!modal.classList.contains('open')) modal.hidden = true;
      }, 300);
      lastFocus?.focus();
    };

    document.querySelectorAll<HTMLElement>('.person-card[data-person-id]').forEach((card) => {
      const id = card.dataset.personId;
      if (!id) return;
      card.addEventListener('click', () => open(id));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(id);
        }
      });
    });

    modal
      .querySelectorAll('[data-modal-close]')
      .forEach((el) => el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
  }

  // Run now, and again after a View Transitions swap. The direct call is what
  // makes this work while site.features.viewTransitions is off: with no
  // <ClientRouter /> on the page, astro:page-load never fires at all.
  initPeopleSearch();
  initPeopleModal();
  document.addEventListener('astro:page-load', () => {
    initPeopleSearch();
    initPeopleModal();
  });
</script>

<style>
  .people-search {
    margin: 1.25rem 0 2rem;
  }

  #people-search-input {
    width: 100%;
    padding: 0.7rem 1rem;
    font-size: 1rem;
    border-radius: 10px;
    border: 1px solid var(--global-divider-color);
    background: var(--global-bg-color);
    color: var(--global-text-color);
    transition: border-color 0.15s ease;
  }

  #people-search-input:focus {
    outline: none;
    border-color: var(--global-theme-color);
  }

  .people-search-empty {
    margin: 0.5rem 0 0;
    color: var(--global-text-color-light);
    font-style: italic;
  }

  h2,
  .person-name,
  .pub-badge,
  .lead-name,
  .lead-eyebrow {
    font-family: 'Space Grotesk', system-ui, sans-serif;
  }

  /* ── Featured lab head(s) ───────────────────────────────────────────── */

  .lead-grid {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 900px) {
    .lead-grid:has(.lead-card:nth-child(2)) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lead-card {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding: 1.75rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 16px;
    background: var(--global-card-bg-color);
    position: relative;
    overflow: hidden;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* Gold accent rail on the leading edge */
  .lead-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(
      to bottom,
      var(--global-theme-color),
      color-mix(in srgb, var(--global-theme-color) 20%, transparent)
    );
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lead-card:hover {
    transform: translateY(-4px);
    border-color: var(--global-theme-color);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
  }

  html[data-theme='dark'] .lead-card:hover {
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
  }

  .lead-card:hover::before {
    transform: scaleY(1);
  }

  .lead-avatar {
    position: relative;
    flex: 0 0 auto;
  }

  .lead-avatar img,
  .lead-avatar .avatar-fallback {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .lead-card:hover .lead-avatar img,
  .lead-card:hover .lead-avatar .avatar-fallback {
    transform: scale(1.03);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--global-theme-color) 32%, transparent);
  }

  .lead-avatar .avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--global-bg-color);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--color-silver);
  }

  .lead-info {
    min-width: 0;
  }

  .lead-eyebrow {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--global-theme-color);
    margin: 0 0 0.35rem;
  }

  .lead-name {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 0.3rem;
  }

  .lead-name a {
    color: var(--global-text-color);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lead-name a:hover {
    color: var(--global-theme-color);
  }

  .lead-role {
    font-size: 0.85rem;
    color: var(--global-text-color-light);
    margin: 0 0 0.6rem;
    line-height: 1.4;
  }

  .lead-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--global-text-color-light);
    margin: 0 0 0.85rem;
    max-width: 52ch;
  }

  .lead-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .lead-links a {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--global-text-color);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--global-divider-color);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .lead-links a:hover {
    color: var(--global-theme-color);
    border-color: var(--global-theme-color);
  }

  .lead-links a.primary {
    color: var(--global-theme-color);
    border-color: color-mix(in srgb, var(--global-theme-color) 50%, transparent);
  }


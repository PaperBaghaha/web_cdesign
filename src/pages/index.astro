<script>
  // Scroll-pinned "Research Areas": as the reader scrolls through the tall
  // wrapper, each row's two items slide in from the two sides to meet in the
  // centre. Row N arrives during the Nth slice of the overall scroll progress.
  (() => {
    const wrap = document.querySelector<HTMLElement>('[data-ra-wrap]');
    if (!wrap) return;
    const rows = Array.from(wrap.querySelectorAll<HTMLElement>('[data-ra-row]'));
    if (!rows.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = window.matchMedia('(max-width: 700px)');

    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    const clamp01 = (v: number) => Math.min(Math.max(v, 0), 1);

    let ticking = false;

    const apply = () => {
      ticking = false;

      // On mobile or with reduced motion, everything just sits in place.
      if (reduce.matches || mobile.matches) {
        rows.forEach((row) => row.style.setProperty('--p', '1'));
        return;
      }

      const vh = window.innerHeight;
      const travel = wrap.offsetHeight - vh; // scrollable distance while pinned
      const scrolled = clamp01(travel > 0 ? -wrap.getBoundingClientRect().top / travel : 1);
      const n = rows.length;

      rows.forEach((row, i) => {
        // Each row owns a 1/n slice of the total progress.
        const local = clamp01(scrolled * n - i);
        row.style.setProperty('--p', easeOut(local).toFixed(4));
      });
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    };

    apply();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', apply);
  })();
</script>

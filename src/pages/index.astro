---
import { Icon } from 'astro-icon/components';
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import { withBase } from '@utils/base';
import { getBoolField, getTitle, getVenue, getYear, parseBibtex } from '@utils/bibtex';
import { getCollection, render } from 'astro:content';

import AboutContent from '../data/about.mdx';
import bibRaw from '../data/papers.bib?raw';

const allAnnouncements = site.announcements.enabled
  ? (await getCollection('announcements'))
      .filter((e) => !e.data.hidden)
      .sort((a, b) => {
        if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
        return b.data.date.getTime() - a.data.date.getTime();
      })
      .slice(0, site.announcements.limit)
  : [];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const bibEntries = parseBibtex(bibRaw);
const selectedPapers = site.selectedPapers.enabled
  ? bibEntries.filter((e) => getBoolField(e, 'selected'))
  : [];

const peopleCount = (await getCollection('people')).length;
const researchAreas = (await getCollection('projects')).sort(
  (a, b) => a.data.importance - b.data.importance,
);
const pubYears = bibEntries.map((e) => getYear(e)).filter((y) => y > 1900);
const yearsActive = pubYears.length > 0 ? new Date().getFullYear() - Math.min(...pubYears) : 0;

// ── Featured Projects cards (built from `selected = {true}` publications) ──────
// Maps a research-area slug back to its human-readable title for the tag chips.
const areaTitleBySlug = new Map(researchAreas.map((p) => [p.id, p.data.title]));

// Long booktitles ("Proceedings of the 2026 CHI Conference…") → short acronyms.
const VENUE_ALIASES: [RegExp, string][] = [
  [/Human Factors in Computing Systems/i, 'CHI'],
  [/Intelligent User Interfaces/i, 'IUI'],
  [/User Interface Software/i, 'UIST'],
  [/Robotics and Automation/i, 'ICRA'],
  [/Computer Vision and Pattern Recognition/i, 'CVPR'],
  [/Computer Supported Cooperative Work/i, 'CSCW'],
];

function shortVenue(entry: (typeof bibEntries)[number]): string {
  const raw = getVenue(entry);
  const year = getYear(entry);
  let label = entry.fields.abbr ?? '';
  if (!label) {
    for (const [re, alias] of VENUE_ALIASES) {
      if (re.test(raw)) {
        label = alias;
        break;
      }
    }
  }
  if (!label) label = raw.length > 24 ? `${raw.slice(0, 22).trim()}…` : raw;
  return year > 1900 ? `${label} ${year}` : label;
}

const featuredPapers = selectedPapers.map((entry) => {
  const title = getTitle(entry);
  // Codename shown on the placeholder card = the short system name. Use the
  // text before the first colon; if the title has no colon (so that text is a
  // long sentence), fall back to just the first word.
  let codename = title.split(':')[0].trim();
  if (codename.length > 16) codename = codename.split(/\s+/)[0];
  const abstract = entry.fields.abstract ?? '';
  const firstSentence = abstract.split(/(?<=[.!?])\s/)[0] ?? '';
  const blurb =
    firstSentence.length > 165 ? `${firstSentence.slice(0, 162).trim()}…` : firstSentence;
  const preview = entry.fields.preview;
  const imgSrc = preview
    ? preview.startsWith('http')
      ? preview
      : withBase(`${site.publications.previewDir}${preview}`)
    : '';
  const tags = (entry.fields.topics ?? '')
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean)
    .map((slug) => areaTitleBySlug.get(slug) ?? slug)
    .slice(0, 2);
  const url = entry.fields.html ?? (entry.fields.doi ? `https://doi.org/${entry.fields.doi}` : '');
  return {
    key: entry.key,
    href: withBase(`/publications/${entry.key}/`),
    title,
    codename,
    venue: shortVenue(entry),
    blurb,
    imgSrc,
    imgAlt: entry.fields.preview_alt ?? title,
    tags,
    url,
  };
});

const renderedAnnouncements = await Promise.all(
  allAnnouncements.map(async (item) => ({ item, rendered: await render(item) })),
);
---

<Base isHome={true}>
  <!-- ═══ HERO — full bleed ═══════════════════════════════════════════════════ -->
  <section class="hero-bleed">
    <!-- Drifting particle field that slowly converges toward the centre —
         a visual nod to "convergence design". Decorative; skipped for
         reduced motion via CSS + the script's own guard. -->
    <canvas class="fx-hero-canvas" aria-hidden="true"></canvas>

    <!-- Left rail: vertical label -->
    <div class="side-rail side-rail-left" aria-hidden="true">
      <span class="rail-text">PURDUE UNIVERSITY · WEST LAFAYETTE · IN</span>
      <div class="rail-line"></div>
      <span class="rail-year">EST. 2008</span>
    </div>

    <!-- Right rail: vertical label -->
    <div class="side-rail side-rail-right" aria-hidden="true">
      <span class="rail-text">CONVERGENCE DESIGN LAB · CDL</span>
      <div class="rail-line"></div>
      <span class="rail-year">ME · HCI · AI</span>
    </div>

    <!-- Centre content -->
    <div class="hero-content page-container">
      <!-- Eyebrow -->
      <p class="hero-eyebrow" data-reveal>Directed by Prof. Karthik Ramani</p>

      <!-- Giant title -->
      <h1 class="hero-title" data-reveal style="--reveal-delay:0.05s">
        <span class="title-word">Convergence</span><br />
        <span class="title-word">Design</span>
        <span class="title-word title-word-light">Lab</span>
      </h1>

      <!-- Sub row: chips + geo -->
      <div class="hero-sub-row" data-reveal style="--reveal-delay:0.1s">
        <!-- Stats left -->
        <div class="chip-col">
          <div class="hero-stats">
            <a class="stat-item" href={`${site.base}/publications/`}>
              <span class="stat-n" data-countup={bibEntries.length} data-suffix="+"
                >{bibEntries.length}+</span
              >
              <span class="stat-l">Publications</span>
            </a>
            <a class="stat-item" href={`${site.base}/projects/`}>
              <span class="stat-n" data-countup={researchAreas.length}>{researchAreas.length}</span>
              <span class="stat-l">Research Areas</span>
            </a>
            <a class="stat-item" href={`${site.base}/people/`}>
              <span class="stat-n" data-countup={peopleCount}>{peopleCount}</span>
              <span class="stat-l">Lab Members</span>
            </a>
            <a class="stat-item" href={`${site.base}/news/`}>
              <span class="stat-n" data-countup={yearsActive} data-suffix="+">{yearsActive}+</span>
              <span class="stat-l">Years Active</span>
            </a>
          </div>
          <!--
            The contact address is spelled out rather than hidden behind a bare
            envelope icon: a naked `mailto:` icon looks broken on any machine
            with no mail client set up, since clicking it appears to do nothing.
            The copy button is the fallback for exactly that case.
          -->
          <div class="hero-social">
            <a class="hero-contact" href={`mailto:${site.socials.email}`}>
              <Icon name="fa-solid:envelope" width={16} height={16} />
              <span>{site.socials.email}</span>
            </a>
            <button
              type="button"
              class="hero-copy"
              data-copy-email={site.socials.email}
              aria-label="Copy email address"
              title="Copy email address"
            >
              <Icon name="fa-solid:copy" width={14} height={14} />
              <span class="hero-copy-label">Copy</span>
            </button>
          </div>
        </div>

        <!-- Geo right -->
        <div class="geo-frame" aria-hidden="true">
          <div class="geo-ring geo-ring-outer"></div>
          <div class="geo-ring geo-ring-inner"></div>
          <div class="geo-cross-h"></div>
          <div class="geo-cross-v"></div>
          <div class="geo-arc"></div>
          <div class="geo-monogram">
            {
              /* Three layers: the circle spins one way, the hexagon spins the
                other way, and the hand sits still in the centre. */
            }
            <svg class="geo-circle" viewBox="0 0 200 200" aria-hidden="true">
              <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="3"
              ></circle>
            </svg>
            <svg class="geo-hex" viewBox="0 0 200 200" aria-hidden="true">
              <polygon
                points="100,16 173,58 173,142 100,184 27,142 27,58"
                fill="none"
                stroke="currentColor"
                stroke-width="3"></polygon>
            </svg>
            <img
              class="geo-hand"
              src={`${site.base}/assets/img/cdl-hand-only.png`}
              alt="Convergence Design Lab"
              width="325"
              height="325"
            />
          </div>
          <div class="geo-corner geo-corner-tl"></div>
          <div class="geo-corner geo-corner-tr"></div>
          <div class="geo-corner geo-corner-bl"></div>
          <div class="geo-corner geo-corner-br"></div>
          <span class="geo-dot" style="top:10%;left:72%;"></span>
          <span class="geo-dot" style="top:80%;left:16%;"></span>
          <span class="geo-dot geo-dot-ring" style="top:68%;left:74%;"></span>
          <span class="geo-dot" style="top:20%;left:22%;"></span>
          <span class="geo-dot geo-dot-ring" style="top:35%;left:80%;"></span>
        </div>
      </div>
    </div>

    <!-- Bottom tick rule (full bleed) -->
    <div class="tick-rule" aria-hidden="true">
      {
        Array.from({ length: 24 }).map((_, i) => (
          <span class="tick" data-major={i % 6 === 0 ? '' : undefined} />
        ))
      }
    </div>
  </section>

  <!-- ═══ FEATURED PROJECTS (compact cards, right below the stats board) ════════ -->
  {
    featuredPapers.length > 0 && (
      <section class="featured page-container" aria-labelledby="featured-heading">
        <div class="featured-head" data-reveal>
          <h2 id="featured-heading" class="featured-title">
            Featured Projects
          </h2>
          <p class="featured-sub">
            A selection of research projects. Click through for papers, videos, and demos.
          </p>
        </div>
        <ul class="featured-grid">
          {featuredPapers.map((p, i) => (
            <li class="feat-cell" data-reveal style={`--reveal-delay:${(i * 0.06).toFixed(2)}s`}>
              <article class="feat-card">
                <a class="feat-media" href={p.href} tabindex="-1" aria-hidden="true">
                  {p.imgSrc ? (
                    <img src={p.imgSrc} alt={p.imgAlt} loading="lazy" />
                  ) : (
                    <span class="feat-mono">{p.codename}</span>
                  )}
                  <span class="feat-venue">{p.venue}</span>
                </a>
                <div class="feat-body">
                  <a class="feat-name" href={p.href}>
                    {p.title}
                  </a>
                  {p.blurb && <p class="feat-blurb">{p.blurb}</p>}
                  {p.tags.length > 0 && (
                    <div class="feat-tags">
                      {p.tags.map((t) => (
                        <span class="feat-tag">{t}</span>
                      ))}
                    </div>
                  )}
                  <div class="feat-actions">
                    <a class="feat-btn feat-btn-primary" href={p.href}>
                      Details →
                    </a>
                    {p.url && (
                      <a class="feat-btn" href={p.url} target="_blank" rel="noopener noreferrer">
                        Paper ↗
                      </a>
                    )}
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <div class="featured-foot" data-reveal>
          <a class="feat-all" href={`${site.base}/publications/`}>
            View all {bibEntries.length}+ publications →
          </a>
        </div>
      </section>
    )
  }

  <!-- ═══ RESEARCH AREAS BAND (scroll-pinned convergence) ═══════════════════════ -->
  <section class="ra-pin-wrap" data-ra-wrap>
    <div class="ra-pin">
      <div class="page-container ra-pin-inner">
        <h2 class="research-band-label mask-reveal" data-reveal>Research Areas</h2>
        <div class="ra-grid">
          {
            Array.from({ length: Math.ceil(researchAreas.length / 2) }).map((_, row) => (
              <div class="ra-row" data-ra-row>
                {researchAreas.slice(row * 2, row * 2 + 2).map((p, j) => (
                  <a
                    class:list={['ra-item', j === 0 ? 'ra-left' : 'ra-right']}
                    href={`${site.base}/projects/${p.id}/`}
                  >
                    <span class="ra-num">{String(row * 2 + j + 1).padStart(2, '0')}</span>
                    <span class="ra-name">{p.data.title}</span>
                    <span class="ra-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT ════════════════════════════════════════════════════════════════ -->
  <section class="two-col-section page-container slide-reveal" data-reveal>
    <div class="col-label">
      <span class="col-tag">About</span>
      <div class="col-tag-rule"></div>
    </div>
    <div class="col-body prose">
      <AboutContent />
    </div>
  </section>

  <!-- ═══ NEWS ════════════════════════════════════════════════════════════════ -->
  {
    site.announcements.enabled && renderedAnnouncements.length > 0 && (
      <section class="two-col-section page-container slide-reveal slide-from-right" data-reveal>
        <div class="col-label">
          <a class="col-tag col-tag-link" href={`${site.base}/news/`}>
            News
          </a>
          <div class="col-tag-rule" />
          <a class="col-more" href={`${site.base}/news/`}>
            All →
          </a>
        </div>
        <table class="news-tbl">
          <tbody>
            {renderedAnnouncements.map(({ item, rendered: { Content } }) => (
              <tr class="news-row">
                <td class="news-date">{formatDate(item.data.date)}</td>
                <td class="news-body">
                  {item.data.title ? (
                    <a href={`${site.base}/news/${item.data.slug ?? item.id}/`}>
                      {item.data.title}
                    </a>
                  ) : (
                    <Content />
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )
  }
</Base>

<style>
  /* ── Fonts ───────────────────────────────────────────────────────────── */
  h1,
  h2,
  .col-tag,
  .stat-n,
  .hero-eyebrow,
  .chip,
  .rail-text,
  .rail-year,
  .geo-monogram,
  .stat-l {
    font-family: 'Space Grotesk', system-ui, sans-serif;
  }

  /* ══ HERO BLEED ═════════════════════════════════════════════════════════ */

  .hero-bleed {
    position: relative;
    width: 100%;
    padding-top: 1.5rem;
    padding-bottom: 0;
    overflow: hidden;
  }

  /* ── Side rails ─────────────────────────────────────────────────────── */

  .side-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    padding-bottom: 1rem;
    z-index: 1;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .side-rail-left {
    left: 0.75rem;
  }
  .side-rail-right {
    right: 0.75rem;
  }

  .rail-text {
    font-size: 0.52rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-silver-dark);
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    white-space: nowrap;
  }

  .side-rail-right .rail-text {
    transform: none;
  }

  .rail-line {
    flex: 1;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-silver-dark) 20%,
      var(--color-silver-dark) 80%,
      transparent
    );
  }

  .rail-year {
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-silver-dark);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .side-rail-right .rail-year {
    transform: none;
  }

  /* Hide rails below 900px where they overlap content */
  @media (max-width: 900px) {
    .side-rail {
      display: none;
    }
  }

  /* ── Hero centre ─────────────────────────────────────────────────────── */

  .hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: 1.75rem;
  }

  .hero-eyebrow {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-silver);
    margin-bottom: 0.75rem;
  }

  .hero-title {
    margin: 0 0 1.5rem;
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  .title-word {
    display: inline;
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 700;
    color: var(--global-text-color);
  }

  .title-word-light {
    font-weight: 300;
    color: var(--color-silver);
    padding-left: 0.18em;
  }

  /* Phones: the 4rem clamp minimum is wider than a small screen, so the title
     overflows off the right edge. Scale it down so it always fits. */
  @media (max-width: 600px) {
    .title-word {
      font-size: clamp(2.5rem, 12.5vw, 4rem);
    }
  }

  /* ── Sub row ──────────────────────────────────────────────────────────── */

  .hero-sub-row {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 2rem;
    align-items: center;
  }

  @media (max-width: 860px) {
    .hero-sub-row {
      grid-template-columns: 1fr;
    }
    .geo-frame {
      display: none;
    }
  }

  /* ── Geometric composition ───────────────────────────────────────────── */

  .geo-frame {
    position: relative;
    width: 220px;
    height: 220px;
    margin-left: auto;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .geo-ring {
    position: absolute;
    border-radius: 50%;
  }

  .geo-ring-outer {
    inset: 0;
    border: 1px solid var(--color-silver-dark);
    animation: spin 50s linear infinite;
  }

  .geo-ring-inner {
    inset: 22%;
    border: 1px dashed var(--color-silver-dark);
    animation: spin 30s linear infinite reverse;
  }

  .geo-arc {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    border: 1px solid transparent;
    border-top-color: var(--color-silver);
    border-right-color: var(--color-silver);
    animation: spin 8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .geo-cross-h,
  .geo-cross-v {
    position: absolute;
    background: var(--color-silver-dark);
  }
  .geo-cross-h {
    top: 50%;
    left: 18%;
    right: 18%;
    height: 1px;
    transform: translateY(-50%);
  }
  .geo-cross-v {
    left: 50%;
    top: 18%;
    bottom: 18%;
    width: 1px;
    transform: translateX(-50%);
  }

  .geo-monogram {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* 3D stage so the hand mark flips in real perspective, not a flat spin. */
    perspective: 700px;
  }

  /* The lab mark is drawn as three stacked layers, all centred on each other:
     an outer CIRCLE, an inscribed HEXAGON, and the HAND. The circle and hexagon
     spin in opposite directions; the hand stays perfectly still in the middle.
     Everything is line art on a transparent background — the colour follows the
     theme (black on light, white on dark) so the outline always contrasts. */
  .geo-circle,
  .geo-hex,
  .geo-hand {
    position: absolute;
    top: 50%;
    left: 50%;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /* Circle + hexagon inherit the theme text colour via currentColor. */
  .geo-circle,
  .geo-hex {
    color: #111;
    overflow: visible;
  }

  :global(html[data-theme='dark']) .geo-circle,
  :global(html[data-theme='dark']) .geo-hex {
    color: #f2f2f2;
  }

  .geo-circle {
    width: 78%;
    height: 78%;
    margin: -39% 0 0 -39%;
    animation: geo-spin3d-y 14s linear infinite;
  }

  .geo-hex {
    width: 62%;
    height: 62%;
    margin: -31% 0 0 -31%;
    animation: geo-spin3d-x 10s linear infinite;
  }

  /* Hand: static, centred, no spin. Black PNG → invert to white in dark mode. */
  .geo-hand {
    width: 34%;
    height: auto;
    margin: -17% 0 0 -17%;
    object-fit: contain;
    background: transparent;
  }

  :global(html[data-theme='dark']) .geo-hand {
    filter: invert(1);
  }

  /* Full 360° 3D rotations. The circle turns on the Y axis (horizontal spin),
     the hexagon on the X axis (vertical tumble) — each keeps a constant tilt on
     the perpendicular axis so the depth reads even as they pass edge-on. */
  @keyframes geo-spin3d-y {
    0% {
      transform: rotateX(16deg) rotateY(0deg);
    }
    100% {
      transform: rotateX(16deg) rotateY(360deg);
    }
  }

  @keyframes geo-spin3d-x {
    0% {
      transform: rotateY(16deg) rotateX(0deg);
    }
    100% {
      transform: rotateY(16deg) rotateX(360deg);
    }
  }

  .geo-corner {
    position: absolute;
    width: 12px;
    height: 12px;
  }
  .geo-corner::before,
  .geo-corner::after {
    content: '';
    position: absolute;
    background: var(--color-silver);
  }
  .geo-corner-tl {
    top: 0;
    left: 0;
  }
  .geo-corner-tl::before {
    top: 0;
    left: 0;
    width: 100%;
    height: 1.5px;
  }
  .geo-corner-tl::after {
    top: 0;
    left: 0;
    width: 1.5px;
    height: 100%;
  }
  .geo-corner-tr {
    top: 0;
    right: 0;
  }
  .geo-corner-tr::before {
    top: 0;
    right: 0;
    width: 100%;
    height: 1.5px;
  }
  .geo-corner-tr::after {
    top: 0;
    right: 0;
    width: 1.5px;
    height: 100%;
  }
  .geo-corner-bl {
    bottom: 0;
    left: 0;
  }
  .geo-corner-bl::before {
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1.5px;
  }
  .geo-corner-bl::after {
    bottom: 0;
    left: 0;
    width: 1.5px;
    height: 100%;
  }
  .geo-corner-br {
    bottom: 0;
    right: 0;
  }
  .geo-corner-br::before {
    bottom: 0;
    right: 0;
    width: 100%;
    height: 1.5px;
  }
  .geo-corner-br::after {
    bottom: 0;
    right: 0;
    width: 1.5px;
    height: 100%;
  }

  .geo-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-silver);
    transform: translate(-50%, -50%);
  }
  .geo-dot-ring {
    background: transparent;
    border: 1.5px solid var(--color-silver-dark);

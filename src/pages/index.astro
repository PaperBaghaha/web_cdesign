---
import SocialLinks from '@components/SocialLinks.astro';
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import { getAuthors, getBoolField, getTitle, getVenue, getYear, parseBibtex } from '@utils/bibtex';
import { getCollection, render } from 'astro:content';

import AboutContent from '../data/about.mdx';
import bibRaw from '../data/papers.bib?raw';

const allAnnouncements = site.announcements.enabled
  ? (await getCollection('announcements'))
      .filter((e) => !e.data.hidden)
      .sort((a, b) => {
        if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
        return b.data.date.getTime() - a.data.date.getTime();
      })
      .slice(0, site.announcements.limit)
  : [];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const bibEntries = parseBibtex(bibRaw);
const selectedPapers = site.selectedPapers.enabled
  ? bibEntries.filter((e) => getBoolField(e, 'selected'))
  : [];

const peopleCount = (await getCollection('people')).length;
const researchAreas = (await getCollection('projects')).sort(
  (a, b) => a.data.importance - b.data.importance,
);
const pubYears = bibEntries.map((e) => getYear(e)).filter((y) => y > 1900);
const yearsActive = pubYears.length > 0 ? new Date().getFullYear() - Math.min(...pubYears) : 0;

const renderedAnnouncements = await Promise.all(
  allAnnouncements.map(async (item) => ({ item, rendered: await render(item) })),
);
---

<Base isHome={true}>
  <!-- ═══ HERO — full bleed ═══════════════════════════════════════════════════ -->
  <section class="hero-bleed">
    <!-- Left rail: vertical label -->
    <div class="side-rail side-rail-left" aria-hidden="true">
      <span class="rail-text">PURDUE UNIVERSITY · WEST LAFAYETTE · IN</span>
      <div class="rail-line"></div>
      <span class="rail-year">EST. 2008</span>
    </div>

    <!-- Right rail: vertical label -->
    <div class="side-rail side-rail-right" aria-hidden="true">
      <span class="rail-text">CONVERGENCE DESIGN LAB · CDL</span>
      <div class="rail-line"></div>
      <span class="rail-year">ME · HCI · AI</span>
    </div>

    <!-- Centre content -->
    <div class="hero-content page-container">
      <!-- Eyebrow -->
      <p class="hero-eyebrow" data-reveal>Directed by Prof. Karthik Ramani</p>

      <!-- Giant title -->
      <h1 class="hero-title" data-reveal style="--reveal-delay:0.05s">
        <span class="title-word">Convergence</span><br />
        <span class="title-word">Design</span>
        <span class="title-word title-word-light">Lab</span>
      </h1>

      <!-- Sub row: chips + geo -->
      <div class="hero-sub-row" data-reveal style="--reveal-delay:0.1s">
        <!-- Stats left -->
        <div class="chip-col">
          <div class="hero-stats">
            <a class="stat-item" href={`${site.base}/publications/`}>
              <span class="stat-n" data-countup={bibEntries.length} data-suffix="+"
                >{bibEntries.length}+</span
              >
              <span class="stat-l">Publications</span>
            </a>
            <a class="stat-item" href={`${site.base}/projects/`}>
              <span class="stat-n" data-countup={researchAreas.length}>{researchAreas.length}</span>
              <span class="stat-l">Research Areas</span>
            </a>
            <a class="stat-item" href={`${site.base}/people/`}>
              <span class="stat-n" data-countup={peopleCount}>{peopleCount}</span>
              <span class="stat-l">Lab Members</span>
            </a>
            <a class="stat-item" href={`${site.base}/news/`}>
              <span class="stat-n" data-countup={yearsActive} data-suffix="+">{yearsActive}+</span>
              <span class="stat-l">Years Active</span>
            </a>
          </div>
          <div class="hero-social">
            <SocialLinks />
          </div>
        </div>

        <!-- Geo right -->
        <div class="geo-frame" aria-hidden="true">
          <div class="geo-ring geo-ring-outer"></div>
          <div class="geo-ring geo-ring-inner"></div>
          <div class="geo-cross-h"></div>
          <div class="geo-cross-v"></div>
          <div class="geo-arc"></div>
          <div class="geo-monogram">
            {/* Three layers: the circle spins one way, the hexagon spins the
                other way, and the hand sits still in the centre. */}
            <svg class="geo-circle" viewBox="0 0 200 200" aria-hidden="true">
              <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="3" />
            </svg>
            <svg class="geo-hex" viewBox="0 0 200 200" aria-hidden="true">
              <polygon
                points="100,16 173,58 173,142 100,184 27,142 27,58"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
              />
            </svg>
            <img
              class="geo-hand"
              src={`${site.base}/assets/img/cdl-hand-only.png`}
              alt="Convergence Design Lab"
              width="325"
              height="325"
            />
          </div>
          <div class="geo-corner geo-corner-tl"></div>
          <div class="geo-corner geo-corner-tr"></div>
          <div class="geo-corner geo-corner-bl"></div>
          <div class="geo-corner geo-corner-br"></div>
          <span class="geo-dot" style="top:10%;left:72%;"></span>
          <span class="geo-dot" style="top:80%;left:16%;"></span>
          <span class="geo-dot geo-dot-ring" style="top:68%;left:74%;"></span>
          <span class="geo-dot" style="top:20%;left:22%;"></span>
          <span class="geo-dot geo-dot-ring" style="top:35%;left:80%;"></span>
        </div>
      </div>
    </div>

    <!-- Bottom tick rule (full bleed) -->
    <div class="tick-rule" aria-hidden="true">
      {
        Array.from({ length: 24 }).map((_, i) => (
          <span class="tick" data-major={i % 6 === 0 ? '' : undefined} />
        ))
      }
    </div>
  </section>

  <!-- ═══ RESEARCH AREAS BAND (scroll-pinned convergence) ═══════════════════════ -->
  <section class="ra-pin-wrap" data-ra-wrap>
    <div class="ra-pin">
      <div class="page-container ra-pin-inner">
        <h2 class="research-band-label">Research Areas</h2>
        <div class="ra-grid">
          {
            Array.from({ length: Math.ceil(researchAreas.length / 2) }).map((_, row) => (
              <div class="ra-row" data-ra-row>
                {researchAreas.slice(row * 2, row * 2 + 2).map((p, j) => (
                  <a
                    class:list={['ra-item', j === 0 ? 'ra-left' : 'ra-right']}
                    href={`${site.base}/projects/${p.id}/`}
                  >
                    <span class="ra-num">{String(row * 2 + j + 1).padStart(2, '0')}</span>
                    <span class="ra-name">{p.data.title}</span>
                    <span class="ra-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT ════════════════════════════════════════════════════════════════ -->
  <section class="two-col-section page-container" data-reveal>
    <div class="col-label">
      <span class="col-tag">About</span>
      <div class="col-tag-rule"></div>
    </div>
    <div class="col-body prose">
      <AboutContent />
    </div>
  </section>

  <!-- ═══ NEWS ════════════════════════════════════════════════════════════════ -->
  {
    site.announcements.enabled && renderedAnnouncements.length > 0 && (
      <section class="two-col-section page-container" data-reveal>
        <div class="col-label">
          <a class="col-tag col-tag-link" href={`${site.base}/news/`}>
            News
          </a>
          <div class="col-tag-rule" />
          <a class="col-more" href={`${site.base}/news/`}>
            All →
          </a>
        </div>
        <table class="news-tbl">
          <tbody>
            {renderedAnnouncements.map(({ item, rendered: { Content } }) => (
              <tr class="news-row">
                <td class="news-date">{formatDate(item.data.date)}</td>
                <td class="news-body">
                  {item.data.title ? (
                    <a href={`${site.base}/news/${item.data.slug ?? item.id}/`}>
                      {item.data.title}
                    </a>
                  ) : (
                    <Content />
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )
  }

  <!-- ═══ SELECTED PUBLICATIONS ════════════════════════════════════════════════ -->
  {
    site.selectedPapers.enabled && selectedPapers.length > 0 && (
      <section class="two-col-section page-container">
        <div class="col-label">
          <a class="col-tag col-tag-link" href={`${site.base}/publications/`}>
            Selected Publications
          </a>
          <div class="col-tag-rule" />
          <a class="col-more" href={`${site.base}/publications/`}>
            All {bibEntries.length}+ →
          </a>
        </div>
        <ol class="pub-list">
          {selectedPapers.map((entry, i) => {
            const title = getTitle(entry);
            const authors = getAuthors(entry);
            const venue = getVenue(entry);
            const year = getYear(entry);
            const abbr = entry.fields.abbr;
            const url =
              entry.fields.html ?? (entry.fields.doi ? `https://doi.org/${entry.fields.doi}` : '');
            return (
              <li class="pub-item" data-reveal style={`--reveal-delay:${(i * 0.05).toFixed(2)}s`}>
                {abbr && <span class="pub-badge">{abbr}</span>}
                {url ? (
                  <a class="pub-title" href={url} target="_blank" rel="noopener noreferrer">
                    {title}
                  </a>
                ) : (
                  <strong class="pub-title">{title}</strong>
                )}
                <span class="pub-meta">
                  {authors}
                  {(venue || year) && (
                    <>
                      {' '}
                      ·{' '}
                      <em>
                        {venue}
                        {venue && year ? ', ' : ''}
                        {year || ''}
                      </em>
                    </>
                  )}
                </span>
              </li>
            );
          })}
        </ol>
      </section>
    )
  }
</Base>

<style>
  /* ── Fonts ───────────────────────────────────────────────────────────── */
  h1,
  h2,
  .col-tag,
  .stat-n,
  .hero-eyebrow,
  .chip,
  .rail-text,
  .rail-year,
  .geo-monogram,
  .stat-l {
    font-family: 'Space Grotesk', system-ui, sans-serif;
  }

  /* ══ HERO BLEED ═════════════════════════════════════════════════════════ */

  .hero-bleed {
    position: relative;
    width: 100%;
    padding-top: 2.5rem;
    padding-bottom: 0;
    overflow: hidden;
  }

  /* ── Side rails ─────────────────────────────────────────────────────── */

  .side-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    padding-bottom: 1rem;
    z-index: 1;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .side-rail-left {
    left: 0.75rem;
  }
  .side-rail-right {
    right: 0.75rem;
  }

  .rail-text {
    font-size: 0.52rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-silver-dark);
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    white-space: nowrap;
  }

  .side-rail-right .rail-text {
    transform: none;
  }

  .rail-line {
    flex: 1;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-silver-dark) 20%,
      var(--color-silver-dark) 80%,
      transparent
    );
  }

  .rail-year {
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-silver-dark);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .side-rail-right .rail-year {
    transform: none;
  }

  /* Hide rails below 900px where they overlap content */
  @media (max-width: 900px) {
    .side-rail {
      display: none;
    }
  }

  /* ── Hero centre ─────────────────────────────────────────────────────── */

  .hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: 2.5rem;
  }

  .hero-eyebrow {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-silver);
    margin-bottom: 0.75rem;
  }

  .hero-title {
    margin: 0 0 2.5rem;
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  .title-word {
    display: inline;
    font-size: clamp(4rem, 9.5vw, 10rem);
    font-weight: 700;
    color: var(--global-text-color);
  }

  .title-word-light {
    font-weight: 300;
    color: var(--color-silver);
    padding-left: 0.18em;
  }

  /* ── Sub row ──────────────────────────────────────────────────────────── */

  .hero-sub-row {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 860px) {
    .hero-sub-row {
      grid-template-columns: 1fr;
    }
    .geo-frame {
      display: none;
    }
  }

  /* ── Geometric composition ───────────────────────────────────────────── */

  .geo-frame {
    position: relative;
    width: 260px;
    height: 260px;
    margin-left: auto;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .geo-ring {
    position: absolute;
    border-radius: 50%;
  }

  .geo-ring-outer {
    inset: 0;
    border: 1px solid var(--color-silver-dark);
    animation: spin 50s linear infinite;
  }

  .geo-ring-inner {
    inset: 22%;
    border: 1px dashed var(--color-silver-dark);
    animation: spin 30s linear infinite reverse;
  }

  .geo-arc {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    border: 1px solid transparent;
    border-top-color: var(--color-silver);
    border-right-color: var(--color-silver);
    animation: spin 8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .geo-cross-h,
  .geo-cross-v {
    position: absolute;
    background: var(--color-silver-dark);
  }
  .geo-cross-h {
    top: 50%;
    left: 18%;
    right: 18%;
    height: 1px;
    transform: translateY(-50%);
  }
  .geo-cross-v {
    left: 50%;
    top: 18%;
    bottom: 18%;
    width: 1px;
    transform: translateX(-50%);
  }

  .geo-monogram {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* 3D stage so the hand mark flips in real perspective, not a flat spin. */
    perspective: 700px;
  }

  /* The lab mark is drawn as three stacked layers, all centred on each other:
     an outer CIRCLE, an inscribed HEXAGON, and the HAND. The circle and hexagon
     spin in opposite directions; the hand stays perfectly still in the middle.
     Everything is line art on a transparent background — the colour follows the
     theme (black on light, white on dark) so the outline always contrasts. */
  .geo-circle,
  .geo-hex,
  .geo-hand {
    position: absolute;
    top: 50%;
    left: 50%;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /* Circle + hexagon inherit the theme text colour via currentColor. */
  .geo-circle,
  .geo-hex {
    color: #111;
    overflow: visible;
  }

  :global(html[data-theme='dark']) .geo-circle,
  :global(html[data-theme='dark']) .geo-hex {
    color: #f2f2f2;
  }

  .geo-circle {
    width: 78%;
    height: 78%;
    margin: -39% 0 0 -39%;
    animation: geo-spin3d-y 14s linear infinite;
  }

  .geo-hex {
    width: 62%;
    height: 62%;
    margin: -31% 0 0 -31%;
    animation: geo-spin3d-x 10s linear infinite;
  }

  /* Hand: static, centred, no spin. Black PNG → invert to white in dark mode. */
  .geo-hand {
    width: 34%;
    height: auto;
    margin: -17% 0 0 -17%;
    object-fit: contain;
    background: transparent;
  }

  :global(html[data-theme='dark']) .geo-hand {
    filter: invert(1);
  }

  /* Full 360° 3D rotations. The circle turns on the Y axis (horizontal spin),
     the hexagon on the X axis (vertical tumble) — each keeps a constant tilt on
     the perpendicular axis so the depth reads even as they pass edge-on. */
  @keyframes geo-spin3d-y {
    0% {
      transform: rotateX(16deg) rotateY(0deg);
    }
    100% {
      transform: rotateX(16deg) rotateY(360deg);
    }
  }

  @keyframes geo-spin3d-x {
    0% {
      transform: rotateY(16deg) rotateX(0deg);
    }
    100% {
      transform: rotateY(16deg) rotateX(360deg);
    }
  }

  .geo-corner {
    position: absolute;
    width: 12px;
    height: 12px;
  }
  .geo-corner::before,
  .geo-corner::after {
    content: '';
    position: absolute;
    background: var(--color-silver);
  }
  .geo-corner-tl {
    top: 0;
    left: 0;
  }
  .geo-corner-tl::before {
    top: 0;
    left: 0;
    width: 100%;
    height: 1.5px;
  }
  .geo-corner-tl::after {
    top: 0;
    left: 0;
    width: 1.5px;
    height: 100%;
  }
  .geo-corner-tr {
    top: 0;
    right: 0;
  }
  .geo-corner-tr::before {
    top: 0;
    right: 0;
    width: 100%;
    height: 1.5px;
  }
  .geo-corner-tr::after {
    top: 0;
    right: 0;
    width: 1.5px;
    height: 100%;
  }
  .geo-corner-bl {
    bottom: 0;
    left: 0;
  }
  .geo-corner-bl::before {
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1.5px;
  }
  .geo-corner-bl::after {
    bottom: 0;
    left: 0;
    width: 1.5px;
    height: 100%;
  }
  .geo-corner-br {
    bottom: 0;
    right: 0;
  }
  .geo-corner-br::before {
    bottom: 0;
    right: 0;
    width: 100%;
    height: 1.5px;
  }
  .geo-corner-br::after {
    bottom: 0;
    right: 0;
    width: 1.5px;
    height: 100%;
  }

  .geo-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-silver);
    transform: translate(-50%, -50%);
  }
  .geo-dot-ring {
    background: transparent;
    border: 1.5px solid var(--color-silver-dark);
    width: 8px;
    height: 8px;
  }

  /* ── Tick rule ────────────────────────────────────────────────────────── */

  .tick-rule {
    display: flex;
    align-items: flex-end;
    height: 20px;
    border-top: 1px solid var(--global-divider-color);
    position: relative;
    padding: 0 2rem;
    gap: 0;
  }

  .tick {
    flex: 1;
    display: block;
    height: 6px;
    border-right: 1px solid var(--global-divider-color);
  }

  .tick[data-major] {
    height: 12px;
    border-right-color: var(--color-silver-dark);
  }

  /* ══ HERO STATS (in the sub-row, next to the logo) ══════════════════════ */

  .hero-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  /* Each stat sits in its own bordered box/card. */
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 14px;
    background-color: color-mix(in srgb, var(--global-text-color) 3%, transparent);
    text-decoration: none;
    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .stat-item:hover {
    border-color: var(--global-theme-color);
    transform: translateY(-3px);
  }

  .stat-n {
    font-size: 2.7rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(135deg, var(--global-text-color) 40%, var(--color-silver) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat-l {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-silver-dark);
  }

  .hero-social {
    margin-top: 1.6rem;
    display: flex;
    align-items: center;
    color: var(--color-silver);
  }

  /* ══ RESEARCH AREAS BAND ════════════════════════════════════════════════ */

  /* Scroll-pinned runway: the section stays fixed on screen while the reader
     scrolls, and each row's two items fly in from the two sides to meet in the
     centre. Once all rows have arrived, the pin releases and normal scrolling
     resumes. The height provides the scroll distance that drives the motion. */
  .ra-pin-wrap {
    position: relative;
    height: 260vh;
  }

  .ra-pin {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1px solid var(--global-divider-color);
    overflow: hidden;
  }

  .ra-pin-inner {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .research-band-label {
    font-size: 2.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }

  .ra-grid {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--global-divider-color);
  }

  .ra-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* --p is the row's 0→1 arrival progress, driven by JS on scroll. */
    --p: 1;
  }

  .ra-item {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    padding: 1.7rem 1.5rem;
    text-decoration: none;
    color: var(--global-text-color);
    border-bottom: 1px solid var(--global-divider-color);
    will-change: transform, opacity;
  }

  /* Left item enters from the left edge; right item from the right edge.
     At --p:0 they sit ~62vw off-centre; at --p:1 they rest in place. */
  .ra-item.ra-left {
    border-right: 1px solid var(--global-divider-color);
    transform: translateX(calc((var(--p) - 1) * 62vw));
    opacity: var(--p);
  }

  .ra-item.ra-right {
    transform: translateX(calc((1 - var(--p)) * 62vw));
    opacity: var(--p);
  }

  .ra-num {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;

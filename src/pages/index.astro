<script>
  // Scroll-pinned "Research Areas": as the reader scrolls through the tall
  // wrapper, each row's two items slide in from the two sides to meet in the
  // centre. Row N arrives during the Nth slice of the overall scroll progress.
  (() => {
    const wrap = document.querySelector<HTMLElement>('[data-ra-wrap]');
    if (!wrap) return;
    const rows = Array.from(wrap.querySelectorAll<HTMLElement>('[data-ra-row]'));
    if (!rows.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = window.matchMedia('(max-width: 700px)');

    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    const clamp01 = (v: number) => Math.min(Math.max(v, 0), 1);

    // Reduced motion: skip all animation, just show the finished grid.
    if (reduce.matches) {
      rows.forEach((row) => row.style.setProperty('--p', '1'));
      return;
    }

    // ── Phone: no sticky pin. Start each row off-centre and let the two items
    //    slide in (via the CSS transition) the moment the row scrolls into
    //    view. This keeps the "converge from both sides" effect working on a
    //    small screen without the janky full-height pinned runway.
    const runMobile = () => {
      rows.forEach((row) => row.style.setProperty('--p', '0'));
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            (entry.target as HTMLElement).style.setProperty('--p', '1');
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.3, rootMargin: '0px 0px -8% 0px' },
      );
      rows.forEach((row) => io.observe(row));
    };

    // ── Desktop: scroll-scrubbed pinned convergence, row by row.
    let ticking = false;
    const apply = () => {
      ticking = false;
      const vh = window.innerHeight;
      const travel = wrap.offsetHeight - vh; // scrollable distance while pinned
      const scrolled = clamp01(travel > 0 ? -wrap.getBoundingClientRect().top / travel : 1);
      const n = rows.length;
      rows.forEach((row, i) => {
        // Each row owns a 1/n slice of the total progress.
        const local = clamp01(scrolled * n - i);
        row.style.setProperty('--p', easeOut(local).toFixed(4));
      });
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    };
    const runDesktop = () => {
      apply();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', apply);
    };

    if (mobile.matches) runMobile();
    else runDesktop();
  })();
</script>

<script>
  // ── Hero particle convergence ─────────────────────────────────────────────
  // A field of points drifts and is gently pulled toward the centre (and the
  // cursor), with faint links between near neighbours — an abstract "many
  // disciplines converging" motif. Pure canvas, no libraries. Pauses when the
  // hero scrolls off-screen and is skipped entirely for reduced motion.
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const canvas = document.querySelector<HTMLCanvasElement>('.fx-hero-canvas');
    if (!canvas || reduce.matches) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const hero = canvas.parentElement as HTMLElement;
    let w = 0;
    let h = 0;
    let dpr = 1;

    type P = { x: number; y: number; vx: number; vy: number };
    let points: P[] = [];

    const strokeColor = () =>
      getComputedStyle(document.documentElement).getPropertyValue('--global-theme-color').trim() ||
      '#c8a15a';

    function build(): void {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = hero.getBoundingClientRect();
      w = r.width;
      h = r.height;
      canvas.width = Math.max(1, Math.floor(w * dpr));
      canvas.height = Math.max(1, Math.floor(h * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // Density scales with area but is capped for performance.
      const count = Math.min(90, Math.round((w * h) / 14000));
      points = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
      }));
    }

    const mouse = { x: -9999, y: -9999 };
    window.addEventListener(
      'pointermove',
      (e) => {
        const r = hero.getBoundingClientRect();
        mouse.x = e.clientX - r.left;
        mouse.y = e.clientY - r.top;
      },
      { passive: true },
    );

    let raf = 0;
    let visible = true;

    function frame(): void {
      raf = requestAnimationFrame(frame);
      if (!visible) return;
      ctx.clearRect(0, 0, w, h);
      const color = strokeColor();
      const cx = w / 2;
      const cy = h / 2;

      for (const p of points) {
        // Gentle pull toward centre keeps the field "converging".
        p.vx += (cx - p.x) * 0.00002;
        p.vy += (cy - p.y) * 0.00002;
        // Cursor repels nearby points for a little life.
        const dxm = p.x - mouse.x;
        const dym = p.y - mouse.y;
        const dm = dxm * dxm + dym * dym;
        if (dm < 14000) {
          const f = (14000 - dm) / 14000;
          p.vx += (dxm / Math.sqrt(dm + 1)) * f * 0.6;
          p.vy += (dym / Math.sqrt(dm + 1)) * f * 0.6;
        }
        p.vx *= 0.96;
        p.vy *= 0.96;
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x += w;
        if (p.x > w) p.x -= w;
        if (p.y < 0) p.y += h;
        if (p.y > h) p.y -= h;
      }

      // Links between near neighbours.
      for (let i = 0; i < points.length; i++) {
        const a = points[i];
        for (let j = i + 1; j < points.length; j++) {
          const b = points[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < 12000) {
            ctx.globalAlpha = (1 - d2 / 12000) * 0.5;
            ctx.strokeStyle = color;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }

      // Nodes.
      ctx.globalAlpha = 0.9;
      ctx.fillStyle = color;
      for (const p of points) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.6, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    build();
    frame();

    let rt = 0;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(build, 150);
    });

    // Pause when the hero is off-screen to save battery.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
      }).observe(hero);
    }

    // Clean up before an in-site view-transition swap.
    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  })();
</script>

<script>
  // 3D pop-up tilt for the Featured Projects cards: the card leans toward the
  // pointer. CSS owns the lift/shadow (see .feat-card:hover) — this only feeds
  // the two rotation angles, so the effect degrades to a plain lift without JS.
  function initFeatTilt(): void {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // Skip touch devices: there's no hover, and the tilt would stick after a tap.
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    const MAX_TILT = 7; // degrees — subtle enough to stay readable

    document.querySelectorAll<HTMLElement>('.feat-card').forEach((card) => {
      let raf = 0;

      const onMove = (e: PointerEvent) => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const r = card.getBoundingClientRect();
          // Pointer position within the card, normalised to -0.5…0.5.
          const px = (e.clientX - r.left) / r.width - 0.5;
          const py = (e.clientY - r.top) / r.height - 0.5;
          // Moving right tilts the right edge away (positive rotateY);
          // moving down tilts the bottom away (negative rotateX).
          card.style.setProperty('--ry', `${(px * MAX_TILT * 2).toFixed(2)}deg`);
          card.style.setProperty('--rx', `${(-py * MAX_TILT * 2).toFixed(2)}deg`);
        });
      };

      const reset = () => {
        if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      };

      card.addEventListener('pointermove', onMove);
      card.addEventListener('pointerleave', reset);
      card.addEventListener('blur', reset, true);
    });
  }

  initFeatTilt();
  document.addEventListener('astro:page-load', initFeatTilt);

  // Copy the lab address to the clipboard. This is the path that works when the
  // visitor has no mail client wired up, where the mailto: link does nothing at
  // all and so reads as a broken button.
  function initCopyEmail(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
      if (btn.dataset.copyBound) return;
      btn.dataset.copyBound = 'true';

      const label = btn.querySelector<HTMLElement>('.hero-copy-label');
      const original = label?.textContent ?? 'Copy';

      btn.addEventListener('click', async () => {
        const email = btn.dataset.copyEmail ?? '';
        try {
          await navigator.clipboard.writeText(email);
          if (label) label.textContent = 'Copied';
        } catch {
          // Clipboard access can be refused (insecure origin, denied permission).
          // Select the address instead so the visitor can copy it by hand.
          const addr = document.querySelector('.hero-contact span');
          if (addr) {
            const range = document.createRange();
            range.selectNodeContents(addr);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
          }
          if (label) label.textContent = 'Select & copy';
        }
        window.setTimeout(() => {
          if (label) label.textContent = original;
        }, 1600);
      });
    });
  }

  initCopyEmail();
  document.addEventListener('astro:page-load', initCopyEmail);
</script>

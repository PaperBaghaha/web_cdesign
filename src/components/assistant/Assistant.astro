---
import type { NavItem } from '@config/site';
import { site } from '@config/site';
import { buildSearchIndex } from '@utils/searchIndex';
import { getCollection } from 'astro:content';
import yaml from 'js-yaml';

import glossaryRaw from '../../data/glossary.yml?raw';

const base = site.base || '';

// ── Quick-nav sections — derived from site.navbar.items (single source of truth) ─
function flattenNav(items: NavItem[]) {
  return items.flatMap((item) => {
    if ('href' in item) {
      return [
        {
          label: item.label.charAt(0).toUpperCase() + item.label.slice(1),
          href: `${base}${item.href}`,
        },
      ];
    }
    return item.children.map((child) => ({
      label: child.label.charAt(0).toUpperCase() + child.label.slice(1),
      href: `${base}${child.href}`,
    }));
  });
}

const navItems = flattenNav(site.navbar.items);

// ── Content index — shared with the ⌘K search palette (src/utils/searchIndex.ts)
// so the two can't drift. `summary`/`body` are what let the assistant *answer*
// rather than merely link; `meta` is a one-line factual header.
const siteIndex = await buildSearchIndex();
const { publications, people, projects } = siteIndex;
const contentItems = siteIndex.all;

// Rich people facts — let the assistant answer "who is …" directly, not just link.
const peopleFacts = (await getCollection('people'))
  .filter((p) => !p.data.noPage)
  .sort((a, b) => (a.data.importance ?? 999) - (b.data.importance ?? 999))
  .map((p) => ({
    name: p.data.name,
    role: p.data.role ?? '',
    description: p.data.description ?? '',
    interests: p.data.interests ?? [],
    href: `${base}/people/${p.id}/`,
  }));

// ── Lab facts — short direct answers for common "what/who is this lab" questions ──
const labFacts = {
  name: site.title ?? site.author.name,
  description: site.description ?? '',
  publicationCount: publications.length,
  peopleCount: people.length,
  /** Research-area titles, so "what research do you do" gets a real answer. */
  areas: projects.map((p) => p.title),
  /** A couple of recent papers, for "what are you working on" style questions. */
  recentPapers: publications.slice(0, 3).map((p) => p.title),
};

// ── Glossary — immediate answers for "what is X?" questions ────────────────────
// The site has no AI model behind it, so definitions have to be written down.
// src/data/glossary.yml is the place to add more.
type GlossaryEntry = { term: string; aliases?: string[]; answer: string; related?: string };

const projectHrefBySlug = new Map(
  (await getCollection('projects')).map((p) => [
    p.id,
    { title: p.data.title, href: `${base}/projects/${p.id}/` },
  ]),
);

const glossary = ((yaml.load(glossaryRaw) ?? []) as GlossaryEntry[]).map((g) => {
  const link = g.related ? projectHrefBySlug.get(g.related) : undefined;
  return {
    term: g.term,
    aliases: g.aliases ?? [],
    answer: g.answer.replace(/\s+/g, ' ').trim(),
    relatedTitle: link?.title ?? '',
    relatedHref: link?.href ?? '',
  };
});

// ── Site credit — assistant-only ───────────────────────────────────────────────
// Not part of the people collection on purpose: this is the site's builder, not a
// lab member, so he appears nowhere on the roster. Only surfaced when a visitor
// asks who made the site, or asks about him by name.
const creditProfile = {
  name: site.credit.builder,
  role: site.credit.role,
  bio: site.credit.bio.replace(/\s+/g, ' ').trim(),
  email: site.credit.email,
  linkedin: site.credit.linkedin,
  aliases: site.credit.aliases.map((a) => a.toLowerCase()),
};

const logoIcon = `${base}/assets/img/cdl-logo-icon.png`;
const assistantName = 'CDL AI Assistant';
const welcomeHeading = `Welcome to ${assistantName}! How can I help you today?`;
const welcomeSub = `Ask me anything about the ${labFacts.name} — our people, publications, research, and courses.`;
const disclaimer = `${assistantName} is AI and can make mistakes. It only knows what's on this website.`;
---

<div
  id="site-assistant"
  data-nav-items={JSON.stringify(navItems)}
  data-content-items={JSON.stringify(contentItems)}
  data-people-facts={JSON.stringify(peopleFacts)}
  data-lab-facts={JSON.stringify(labFacts)}
  data-glossary={JSON.stringify(glossary)}
  data-credit={JSON.stringify(creditProfile)}
  data-pagefind-base={base}
  data-email={site.author.email}
  data-author={site.author.name}
  data-name={assistantName}
  data-welcome-heading={welcomeHeading}
  data-welcome-sub={welcomeSub}
  data-disclaimer={disclaimer}
>
  <button id="assistant-toggle" aria-label="Open the site assistant" aria-expanded="false">
    <img
      src={logoIcon}
      alt=""
      class="assistant-toggle-logo"
      aria-hidden="true"
      width="512"
      height="512"
    />
  </button>

  <div id="assistant-overlay" hidden></div>

  <div id="assistant-panel" role="dialog" aria-label="Site assistant" aria-modal="true" hidden>
    <header id="assistant-head">
      <span id="assistant-title">
        <img
          src={logoIcon}
          alt=""
          class="assistant-title-logo"
          aria-hidden="true"
          width="512"
          height="512"
        />
        <span id="assistant-title-text"></span>
      </span>
      <button id="assistant-close" aria-label="Close the assistant">
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </header>

    <div id="assistant-body">
      <div id="assistant-hero">
        <div id="assistant-hero-badge" aria-hidden="true">
          <img src={logoIcon} alt="" width="512" height="512" />
        </div>
        <h2 id="assistant-hero-heading"></h2>
        <p id="assistant-hero-sub"></p>
      </div>

      <div id="assistant-log" aria-live="polite"></div>

      <div id="assistant-chips"></div>
    </div>

    <div id="assistant-footer">
      <form id="assistant-form" autocomplete="off">
        <input
          id="assistant-input"
          type="text"
          placeholder="Ask anything…"
          aria-label="Ask the site assistant"
        />
        <div id="assistant-controls">
          <div class="assistant-controls-left">
            <button type="button" id="assistant-new-thread">
              <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14"></path>
              </svg>
              New Thread
            </button>
          </div>
          <div class="assistant-controls-right">
            <div class="assistant-mode-wrap">
              <select id="assistant-mode" aria-label="Answer mode">
                <option value="fast">Fast</option>
                <option value="detailed">Detailed</option>
              </select>
              <svg
                class="assistant-mode-caret"
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
            <button type="submit" id="assistant-send" aria-label="Send message">
              <svg
                viewBox="0 0 24 24"
                width="19"
                height="19"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 19V5M5 12l7-7 7 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </form>
      <p id="assistant-disclaimer"></p>
    </div>
  </div>
</div>

<script>
  type NavItem = { label: string; href: string };
  type ContentItem = {
    title: string;
    section: string;
    href: string;
    keywords?: string;
    summary?: string;
    meta?: string;
    body?: string;
  };
  type GlossaryTerm = {
    term: string;
    aliases: string[];
    answer: string;
    relatedTitle: string;
    relatedHref: string;
  };

  function initAssistant() {
    const root = document.getElementById('site-assistant');
    // transition:persist keeps this element alive across page swaps — only wire it once.
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const toggle = document.getElementById('assistant-toggle') as HTMLButtonElement;
    const overlay = document.getElementById('assistant-overlay') as HTMLElement;
    const panel = document.getElementById('assistant-panel') as HTMLElement;
    const closeBtn = document.getElementById('assistant-close') as HTMLButtonElement;
    const body = document.getElementById('assistant-body') as HTMLElement;
    const hero = document.getElementById('assistant-hero') as HTMLElement;
    const heroHeading = document.getElementById('assistant-hero-heading') as HTMLElement;
    const heroSub = document.getElementById('assistant-hero-sub') as HTMLElement;
    const log = document.getElementById('assistant-log') as HTMLElement;
    const chips = document.getElementById('assistant-chips') as HTMLElement;
    const form = document.getElementById('assistant-form') as HTMLFormElement;
    const input = document.getElementById('assistant-input') as HTMLInputElement;
    const titleText = document.getElementById('assistant-title-text') as HTMLElement;
    const disclaimerEl = document.getElementById('assistant-disclaimer') as HTMLElement;
    const newThreadBtn = document.getElementById('assistant-new-thread') as HTMLButtonElement;
    const modeSelect = document.getElementById('assistant-mode') as HTMLSelectElement;

    // "Fast" gives a couple of top hits; "Detailed" returns more related links.
    let mode: 'fast' | 'detailed' = 'fast';

    type PersonFact = {
      name: string;
      role: string;
      description: string;
      interests: string[];
      href: string;
    };

    const navItems: NavItem[] = JSON.parse(root.dataset.navItems ?? '[]');
    const contentItems: ContentItem[] = JSON.parse(root.dataset.contentItems ?? '[]');
    const peopleFacts: PersonFact[] = JSON.parse(root.dataset.peopleFacts ?? '[]');
    const labFacts: {
      name: string;
      description: string;
      publicationCount: number;
      peopleCount: number;
      areas: string[];
      recentPapers: string[];
    } = JSON.parse(
      root.dataset.labFacts ??
        '{"name":"","description":"","publicationCount":0,"peopleCount":0,"areas":[],"recentPapers":[]}',
    );
    const glossary: GlossaryTerm[] = JSON.parse(root.dataset.glossary ?? '[]');

    type Credit = {
      name: string;
      role: string;
      bio: string;
      email: string;
      linkedin: string;
      aliases: string[];
    };
    const credit: Credit = JSON.parse(
      root.dataset.credit ?? '{"name":"","role":"","bio":"","email":"","linkedin":"","aliases":[]}',
    );
    const pagefindBase = root.dataset.pagefindBase ?? '';
    const email = root.dataset.email ?? '';
    const author = root.dataset.author ?? '';
    const assistantName = root.dataset.name ?? 'Assistant';
    const welcomeHeading = root.dataset.welcomeHeading ?? '';
    const welcomeSub = root.dataset.welcomeSub ?? '';
    const disclaimer = root.dataset.disclaimer ?? '';

    titleText.textContent = assistantName;
    heroHeading.textContent = welcomeHeading;
    heroSub.textContent = welcomeSub;
    disclaimerEl.textContent = disclaimer;

    let greeted = false;

    // Show the welcome hero while no messages exist; hide it once a chat starts.
    function startConversation() {
      hero.hidden = true;
      body.classList.add('is-chatting');
    }
    function resetToHero() {
      hero.hidden = false;
      body.classList.remove('is-chatting');
    }

    // ── Message bubbles (textContent only — never innerHTML with dynamic text) ──
    function addBubble(who: 'bot' | 'user', text: string, copyable = false): HTMLElement {
      const el = document.createElement('div');
      el.className = `assistant-msg assistant-msg--${who}`;

      const body = document.createElement('div');
      body.className = 'assistant-msg-text';
      body.textContent = text;
      el.appendChild(body);

      // A "Copy" action under substantive bot answers, like a real AI chat.
      if (who === 'bot' && copyable) {
        const actions = document.createElement('div');
        actions.className = 'assistant-msg-actions';
        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'assistant-copy';
        const label = document.createElement('span');
        label.textContent = 'Copy';
        copy.appendChild(label);
        copy.addEventListener('click', () => {
          navigator.clipboard?.writeText(text).then(() => {
            label.textContent = 'Copied';
            window.setTimeout(() => (label.textContent = 'Copy'), 1500);
          });
        });
        actions.appendChild(copy);
        el.appendChild(actions);
      }

      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    function addLinks(results: { title: string; section?: string; href: string }[]) {
      const wrap = document.createElement('div');
      wrap.className = 'assistant-msg assistant-msg--bot assistant-results';
      results.forEach((r) => {
        const a = document.createElement('a');
        a.className = 'assistant-result';
        a.href = r.href;
        const t = document.createElement('span');
        t.className = 'assistant-result-title';
        t.textContent = r.title;
        a.appendChild(t);
        if (r.section) {
          const s = document.createElement('span');
          s.className = 'assistant-result-section';
          s.textContent = r.section;
          a.appendChild(s);
        }
        wrap.appendChild(a);
      });
      log.appendChild(wrap);
      log.scrollTop = log.scrollHeight;
    }

    // ── Suggested prompts — click to ask, RadarAI-style ────────────────────────
    const suggestedPrompts = [
      `What is the ${labFacts.name}?`,
      'What is the difference between AR, VR and MR?',
      'What research does the lab do?',
      'Who are the people in the lab?',
      'How can I contact the lab?',
    ];
    function renderChips() {
      chips.replaceChildren();
      suggestedPrompts.forEach((q) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'assistant-chip';
        b.textContent = q;
        b.addEventListener('click', () => {
          input.value = '';
          handleQuery(q);
        });
        chips.appendChild(b);
      });
    }

    // ── Pagefind (full-text, present after `yarn build`) with dev-mode fallback ──
    let pagefind: any = null;
    let pagefindTried = false;
    async function loadPagefind() {
      if (pagefindTried) return pagefind;
      pagefindTried = true;
      try {
        pagefind = await import(/* @vite-ignore */ `${pagefindBase}/pagefind/pagefind.js`);
        await pagefind.init();
      } catch {
        pagefind = null;
      }
      return pagefind;
    }

    // Question / filler words that shouldn't drive matching.
    const STOPWORDS = new Set([
      'a',
      'an',
      'the',
      'is',
      'are',
      'was',
      'were',
      'do',
      'does',
      'did',
      'of',
      'in',
      'on',
      'at',
      'to',
      'for',
      'and',
      'or',
      'with',
      'about',
      'who',
      'what',
      'when',
      'where',
      'which',
      'how',
      'why',
      'me',
      'i',
      'you',
      'your',
      'my',
      'can',
      'could',
      'would',
      'tell',
      'show',
      'find',
      'give',
      'any',
      'some',
      'there',
      'their',
      'have',
      'has',
      'this',
      'that',
      'from',
      'by',
      'it',
      'lab',
      'cdl',
    ]);

    function tokenize(s: string): string[] {
      return (s.toLowerCase().match(/[a-z0-9]+/g) ?? []).filter((w) => !STOPWORDS.has(w));
    }

    // Token-scored search over the pre-built index (publications, people, projects,
    // posts, courses). Works identically in `yarn dev` and production.
    function localSearch(query: string): ContentItem[] {
      const terms = tokenize(query);
      if (terms.length === 0) return [];
      return contentItems
        .map((c) => {
          const title = c.title.toLowerCase();
          const hay = `${title} ${(c.keywords ?? '').toLowerCase()}`;
          const summary = `${(c.summary ?? '').toLowerCase()} ${(c.body ?? '').toLowerCase()}`;
          let score = 0;
          for (const t of terms) {
            // Whole-word matches count for far more than substrings: searching
            // "hand tracking" should not rank "handwriting" above a hand-tracking
            // paper.
            const word = new RegExp(`\\b${t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`);
            if (word.test(title)) score += 4;
            else if (title.includes(t)) score += 1.5;
            else if (word.test(hay)) score += 1.5;
            else if (hay.includes(t)) score += 0.5;
            // A summary hit is weak on its own but breaks ties sensibly and lets
            // topic questions ("hand tracking") reach papers that never say it
            // in the title.
            if (word.test(summary)) score += 0.75;
            else if (summary.includes(t)) score += 0.2;
          }
          // The six research-area pages are the canonical overview of each topic,
          // so nudge them above any single paper that happens to share wording.
          if (c.section === 'Research') score *= 1.4;
          return { c, score };
        })
        .filter((x) => x.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 6)
        .map((x) => x.c);
    }

    // Find the lab member a query is asking about. Returns the best name match and
    // whether every word of their name appears in the query (a confident full match).
    function findPerson(query: string): { person: PersonFact; full: boolean } | null {
      const qTokens = new Set(query.toLowerCase().match(/[a-z0-9]+/g) ?? []);
      if (qTokens.size === 0) return null;
      let best: { person: PersonFact; matched: number; total: number } | null = null;
      for (const person of peopleFacts) {
        const nameTokens = (person.name.toLowerCase().match(/[a-z0-9]+/g) ?? []).filter(
          (t) => t.length >= 2,
        );
        if (nameTokens.length === 0) continue;
        const matched = nameTokens.filter((t) => qTokens.has(t));
        // Require a distinctive hit: a name word of 4+ chars present in the query.
        const distinctive = matched.some((t) => t.length >= 4);
        if (matched.length === 0 || !distinctive) continue;
        if (!best || matched.length > best.matched) {
          best = { person, matched: matched.length, total: nameTokens.length };
        }
      }
      if (!best) return null;
      return { person: best.person, full: best.matched >= best.total };
    }

    function answerPerson(p: PersonFact) {
      let msg = p.name;
      if (p.role) msg += ` — ${p.role}`;
      msg += '.';
      if (p.description) msg += ` ${p.description}`;
      if (p.interests.length) msg += ` Research interests: ${p.interests.join(', ')}.`;
      addBubble('bot', msg, true);
      addLinks([{ title: `${p.name}'s profile`, href: p.href, section: 'People' }]);
    }

    /**
     * The site's builder. He isn't on the roster, so there's no profile page to
     * link — the contact details are the whole answer.
     */
    function answerCredit() {
      let msg = credit.name;
      if (credit.role) msg += ` — ${credit.role}`;
      msg += '.';
      if (credit.bio) msg += ` ${credit.bio}`;
      addBubble('bot', msg, true);
      const links: { title: string; section?: string; href: string }[] = [];
      if (credit.email) {
        links.push({ title: credit.email, href: `mailto:${credit.email}`, section: 'Email' });
      }
      if (credit.linkedin) {
        links.push({ title: 'LinkedIn', href: credit.linkedin, section: 'Profile' });
      }
      if (links.length) addLinks(links);
    }

    /** True when the query names the builder — he has no roster entry to match against. */
    function mentionsCredit(query: string): boolean {
      if (!credit.name) return false;
      // Padded so an alias only matches whole words: "dang" must not fire on
      // "dangerous" or "danger".
      const q = ` ${query
        .toLowerCase()
        .replace(/[^a-z\s]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim()} `;
      return credit.aliases.some((a) => a.length >= 4 && q.includes(` ${a} `));
    }

    async function search(query: string) {
      const local = localSearch(query);

      // In production, Pagefind adds full-text page matches. Merge, de-duplicating by href.
      const pf = await loadPagefind();
      if (pf) {
        try {
          const response = await pf.search(tokenize(query).join(' ') || query);
          const data = await Promise.all(response.results.slice(0, 6).map((r: any) => r.data()));
          const seen = new Set(local.map((r) => r.href.replace(/\/$/, '')));
          for (const d of data) {
            const href = (d.url as string) ?? '';
            if (!href || seen.has(href.replace(/\/$/, ''))) continue;
            seen.add(href.replace(/\/$/, ''));
            local.push({ title: d.meta?.title || href, href, section: '' });
          }
        } catch {
          /* pagefind absent in dev — local results are enough */
        }
      }

      return local.slice(0, 8);
    }

    // ── Direct answers ─────────────────────────────────────────────────────────
    // The assistant should *answer*, not just hand over a list of links. We take
    // the best-matching item, speak its summary as a short highlight, and only
    // then offer links underneath for readers who want the full page.

    /**
     * Match a "what is X?" question against the glossary. Longer terms are tried
     * first so "mixed reality" wins over the bare alias "mr".
     */
    function findTerms(query: string): GlossaryTerm[] {
      const q = ` ${query
        .toLowerCase()
        .replace(/[^a-z0-9\s]/g, ' ')
        .replace(/\s+/g, ' ')} `;
      const hits: { term: GlossaryTerm; len: number }[] = [];
      for (const g of glossary) {
        let bestLen = 0;
        for (const alias of [g.term, ...g.aliases]) {
          const a = alias
            .toLowerCase()
            .replace(/[^a-z0-9\s]/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
          if (!a || !q.includes(` ${a} `)) continue;
          bestLen = Math.max(bestLen, a.length);
        }
        if (bestLen > 0) hits.push({ term: g, len: bestLen });
      }
      // "What is the difference between AR, VR and MR?" legitimately matches three
      // terms — answer them all, longest (most specific) match first.
      return hits
        .sort((a, b) => b.len - a.len)
        .map((h) => h.term)
        .slice(0, 3);
    }

    /**
     * Pick the sentences from an item's text that actually answer the question,
     * rather than always quoting the opening. Sentences are scored by how many of
     * the query's words they contain; the best one is returned with its neighbour
     * for context. Falls back to the stored summary when nothing matches.
     */
    function bestPassage(item: ContentItem, query: string): string {
      const source =
        item.body && item.body.length > (item.summary ?? '').length ? item.body : item.summary;
      if (!source) return item.summary ?? '';
      const terms = tokenize(query);
      const sentences = source.split(/(?<=[.!?])\s+/).filter((s) => s.trim().length > 20);
      if (terms.length === 0 || sentences.length === 0) return item.summary ?? source;

      let bestIdx = -1;
      let bestScore = 0;
      sentences.forEach((s, i) => {
        const low = s.toLowerCase();
        const score = terms.reduce((acc, t) => acc + (low.includes(t) ? 1 : 0), 0);
        if (score > bestScore) {
          bestScore = score;
          bestIdx = i;
        }
      });
      if (bestIdx < 0) return item.summary ?? sentences[0];

      // The matching sentence plus the following one, capped so answers stay short.
      let out = sentences[bestIdx];
      const next = sentences[bestIdx + 1];
      if (next && (out + ' ' + next).length <= 320) out += ` ${next}`;
      return out.trim();
    }

    /** Article for a section name, so the lead sentence reads naturally. */
    function describeSection(section: string): string {
      switch (section) {
        case 'Publication':
          return 'a paper from the lab';
        case 'People':
          return 'a member of the lab';
        case 'Research':
          return 'one of our research areas';
        case 'Courses':
          return 'a course we teach';
        case 'Blog':
          return 'a post on our blog';
        default:
          return 'a page on this site';
      }
    }

    /**
     * Speak a highlight for `item`, then link it (plus any related hits).
     * Returns false when there's nothing worth speaking, so the caller can fall
     * back to a plain link list.
     */
    function answerFromItem(item: ContentItem, related: ContentItem[], query: string): boolean {
      const passage = bestPassage(item, query);
      if (!passage) return false;

      const lead = `${item.title} — ${describeSection(item.section)}.`;
      const parts = [lead];
      if (item.meta) parts.push(`(${item.meta})`);
      parts.push(passage);
      addBubble('bot', parts.join(' '), true);

      const links: { title: string; section?: string; href: string }[] = [
        { title: `Read the full page: ${item.title}`, section: item.section, href: item.href },
      ];
      // Detailed mode offers more of the related trail; fast mode keeps it tight.
      const extra = related
        .filter((r) => r.href !== item.href)
        .slice(0, mode === 'detailed' ? 4 : 2);
      for (const r of extra) links.push({ title: r.title, section: r.section, href: r.href });
      addLinks(links);
      return true;
    }

    // Answer a single query.
    //  'answer'    → a real answer was given; offer a follow-up afterwards
    //  'smalltalk' → greeting/thanks/bye handled; no follow-up needed
    //  'none'      → nothing matched
    async function route(query: string): Promise<'answer' | 'smalltalk' | 'none'> {
      const cleaned = query
        .toLowerCase()
        .replace(/[^a-z\s]/g, '')
        .trim();

      // Small talk: greetings — just say hi back, don't run a search.
      if (
        /^(hi+|hey+|hello+|helo|yo+|hiya|howdy|sup|wassup|greetings|good\s?(morning|afternoon|evening|day))(\s?(there|everyone|assistant))?$/.test(
          cleaned,
        )
      ) {
        addBubble('bot', `Hello! How can I help you today?`);
        return 'smalltalk';
      }

      // Small talk: thanks.
      if (/^(thanks|thank\s?you|thx|ty|cheers|much appreciated|appreciate it)$/.test(cleaned)) {
        addBubble('bot', `You're welcome!`);
        return 'smalltalk';
      }

      // Small talk: goodbye.
      if (/^(bye+|goodbye|see\s?you|see ya|cya|take care|good night)$/.test(cleaned)) {
        addBubble('bot', `Goodbye! Come back anytime.`);
        return 'smalltalk';
      }

      // Small talk: how are you.
      if (/^(how are you|hows it going|how do you do|whats up)$/.test(cleaned)) {
        addBubble('bot', `I'm good, thanks! How can I help you today?`);
        return 'smalltalk';
      }

      // Intent: who built the site. Runs before the contact and person routes so
      // "who made this website" isn't swallowed by the lab-email answer.
      if (
        /\b(who|what|which)\b/i.test(query) &&
        /\b(built|build|builds|made|make|makes|created?|creates|designed?|designs|developed?|develops|coded?|codes|wrote|maintains?|behind|author(ed)?)\b/i.test(
          query,
        ) &&
        /\b(site|website|web\s?site|webpage|web\s?page|page|this)\b/i.test(query)
      ) {
        answerCredit();
        return 'answer';
      }

      // Intent: asked about the builder by name.
      if (mentionsCredit(query)) {
        answerCredit();
        return 'answer';
      }

      // Intent: contact / how to reach the author.
      if (/\b(contact|email|e-?mail|reach|get in touch|message)\b/i.test(query) && email) {
        addBubble('bot', `You can reach ${author} by email:`);
        addLinks([{ title: email, href: `mailto:${email}`, section: 'Email' }]);
        return 'answer';
      }

      // Intent: a definition question ("what is AR?", "explain mixed reality").
      // Answered immediately from the glossary; the lab page goes underneath.
      // Runs before the person lookup so short names can't hijack a term, but
      // only when the phrasing really is a definition request.
      const asksDefinition =
        /\b(what|whats|what's|define|definition|meaning|means|mean|explain|difference|stand for|about)\b/i.test(
          query,
        ) || query.trim().split(/\s+/).length <= 3;
      // A bare "Mr Ramani" must not be read as a request to define "MR".
      if (asksDefinition && !findPerson(query)) {
        const terms = findTerms(query);
        if (terms.length > 0) {
          addBubble('bot', terms.map((t) => `${t.term}: ${t.answer}`).join('\n\n'), true);
          const seen = new Set<string>();
          const links: { title: string; section?: string; href: string }[] = [];
          for (const t of terms) {
            if (!t.relatedHref || seen.has(t.relatedHref)) continue;
            seen.add(t.relatedHref);
            links.push({
              title: `How we work on this: ${t.relatedTitle}`,
              section: 'Research',
              href: t.relatedHref,
            });
          }
          if (links.length) addLinks(links);
          return 'answer';
        }
      }

      const navByLabel = (label: string) =>
        navItems.find((n) => n.label.toLowerCase() === label.toLowerCase());

      // Intent: a question about a specific lab member — answer directly.
      // Fires on a confident full-name match, or on any "who is / tell me about /
      // bio / profile" phrasing that also names someone in the lab.
      const asksAboutPerson =
        /\bwho\b|tell me about|\bbio\b|\bprofile\b|\bwork(s|ing)?\s+on\b/i.test(query);
      const personMatch = findPerson(query);
      if (personMatch && (personMatch.full || asksAboutPerson)) {
        answerPerson(personMatch.person);
        return 'answer';
      }

      // Intent: what research does the lab do — name the areas outright.
      // Must precede the generic "what is the lab" intent, which also matches
      // the word "research".
      if (
        /\b(research|work|working|topic|area|focus|study|studies)\b/i.test(query) &&
        /\b(what|which|kind|kinds|type|types|tell|describe|list|overview|areas?|about)\b/i.test(
          query,
        ) &&
        labFacts.areas.length > 0 &&
        !findPerson(query)
      ) {
        const list = labFacts.areas.slice(0, 6).join(', ');
        addBubble(
          'bot',
          `We work across ${labFacts.areas.length} main research areas: ${list}. Across them we've published ${labFacts.publicationCount} papers. Pick an area below for the full write-up.`,
          true,
        );
        const areaLinks = contentItems
          .filter((c) => c.section === 'Research')
          .slice(0, mode === 'detailed' ? 6 : 4)
          .map((c) => ({ title: c.title, section: c.section, href: c.href }));
        const researchNav = navByLabel('Research') ?? navByLabel('Projects');
        if (researchNav)
          areaLinks.push({ title: 'All research areas', section: '', href: researchNav.href });
        addLinks(areaLinks);
        return 'answer';
      }

      // Intent: who's in the lab — name a few, then link the roster.
      // Requires an explicit roster word — a bare "who…" is usually about a
      // specific person or paper, which the intents above/below handle better.
      if (
        /\b(people|members?|team|students?|researchers?|staff|lab\s?mates?)\b/i.test(query) &&
        !/\b(paper|publication|wrote|author)/i.test(query) &&
        peopleFacts.length > 0
      ) {
        const names = peopleFacts
          .slice(0, 5)
          .map((p) => p.name)
          .join(', ');
        const more = peopleFacts.length > 5 ? `, and ${peopleFacts.length - 5} more` : '';
        addBubble(
          'bot',
          `The lab has ${labFacts.peopleCount} people listed, including ${names}${more}. Ask me about anyone by name and I'll tell you what they work on.`,
          true,
        );
        const ppl = navByLabel('People') ?? navByLabel('Team');
        if (ppl) addLinks([{ title: 'Meet the whole team', href: ppl.href, section: 'People' }]);
        return 'answer';
      }

      // Intent: what/who is the lab — describe it and point to About.
      if (
        /\b(what|who|tell|about|describe)\b/i.test(query) &&
        /\b(lab|cdl|convergence|you|this|research)\b/i.test(query)
      ) {
        if (labFacts.description) {
          const scale = labFacts.peopleCount
            ? ` We're ${labFacts.peopleCount} people with ${labFacts.publicationCount} publications.`
            : '';
          addBubble('bot', `${labFacts.description}${scale}`, true);
        }
        const about = navByLabel('About') ?? navByLabel('Home');
        if (about) addLinks([{ title: about.label, href: about.href }]);
        return 'answer';
      }

      // Intent: how many publications / papers.
      if (/\bhow many\b/i.test(query) && /\b(publication|paper|pub)/i.test(query)) {
        const recent = labFacts.recentPapers.length
          ? ` Recent ones include ${labFacts.recentPapers.join('; ')}.`
          : '';
        addBubble('bot', `The lab lists ${labFacts.publicationCount} publications.${recent}`, true);
        const pubs = navByLabel('Publications');
        if (pubs) addLinks([{ title: 'Publications', href: pubs.href }]);
        return 'answer';
      }

      // Intent: how many people / members.
      if (/\bhow many\b/i.test(query) && /\b(people|member|student|researcher)/i.test(query)) {
        addBubble('bot', `There are ${labFacts.peopleCount} people listed. Meet the team here:`);
        const ppl = navByLabel('People') ?? navByLabel('Team');
        if (ppl) addLinks([{ title: 'People', href: ppl.href }]);
        return 'answer';
      }

      const thinking = addBubble('bot', 'Thinking…');
      const found = await search(query);
      thinking.remove();

      // Preferred path: speak a highlight from the best match, links underneath.
      const best = found.find((r) => r.summary || r.body);
      if (best && answerFromItem(best, found, query)) return 'answer';

      // Nothing had a written summary — fall back to a link list.
      const results = found.slice(0, mode === 'detailed' ? 8 : 4);
      if (results.length > 0) {
        addBubble(
          'bot',
          `I don't have a written summary for that, but these pages cover “${query}”:`,
        );
        addLinks(results);
        return 'answer';
      }

      addBubble(
        'bot',
        `I don't have anything on that yet. I answer from what's written on this site — our ${labFacts.peopleCount} lab members, ${labFacts.publicationCount} publications, ${labFacts.areas.length} research areas, and our courses — plus definitions of terms like AR, VR, MR, and geometric deep learning. Try naming a person, a paper, or a topic.`,
      );
      return 'none';
    }

    async function handleQuery(raw: string) {
      const query = raw.trim();
      if (!query) return;
      // The first question swaps the welcome hero out for the chat transcript.
      startConversation();
      addBubble('user', query);
      // Once the visitor starts asking, drop the suggested prompts so each answer
      // stands on its own instead of repeating "About / Research / People…".
      chips.replaceChildren();

      const status = await route(query);
      if (status === 'answer') {
        addBubble('bot', 'Is there anything else I can help you with?');
      }
    }

    // ── Open / close ───────────────────────────────────────────────────────────
    function open() {
      overlay.hidden = false;
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      root?.classList.add('is-open');
      // Lock page scroll so the blurred site behind the pop-up can't be used.
      document.documentElement.classList.add('assistant-docked');
      if (!greeted) {
        greeted = true;
        renderChips();
      }
      window.setTimeout(() => input.focus(), 60);
    }

    function close() {
      overlay.hidden = true;
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      root?.classList.remove('is-open');
      document.documentElement.classList.remove('assistant-docked');
      // Reset the whole conversation, so reopening the assistant starts fresh
      // with just the welcome hero and the suggested prompts again.
      log.replaceChildren();
      chips.replaceChildren();
      input.value = '';
      greeted = false;
      resetToHero();
    }

    toggle.addEventListener('click', () => (panel.hidden ? open() : close()));
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', close);
    // Navbar "CDL AI" button (and any other launcher) opens the assistant.
    window.addEventListener('assistant:open', () => {
      if (panel.hidden) open();
      else window.setTimeout(() => input.focus(), 30);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = input.value;
      input.value = '';
      handleQuery(value);
    });

    // "New Thread" — wipe the transcript and return to the welcome screen.
    newThreadBtn.addEventListener('click', () => {
      log.replaceChildren();
      input.value = '';
      resetToHero();
      renderChips();
      input.focus();
    });

    // Answer mode selector (Fast / Detailed).
    modeSelect.addEventListener('change', () => {
      mode = modeSelect.value === 'detailed' ? 'detailed' : 'fast';
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });
  }

  initAssistant();
  document.addEventListener('astro:after-swap', initAssistant);
</script>


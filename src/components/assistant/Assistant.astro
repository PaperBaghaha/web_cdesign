---
import type { NavItem } from '@config/site';
import { site } from '@config/site';
import { getAuthors, getTitle, getVenue, getYear, parseBibtex } from '@utils/bibtex';
import { getCollection } from 'astro:content';

import bibRaw from '../../data/papers.bib?raw';

const base = site.base || '';

// ── Quick-nav sections — derived from site.navbar.items (single source of truth) ─
function flattenNav(items: NavItem[]) {
  return items.flatMap((item) => {
    if ('href' in item) {
      return [
        {
          label: item.label.charAt(0).toUpperCase() + item.label.slice(1),
          href: `${base}${item.href}`,
        },
      ];
    }
    return item.children.map((child) => ({
      label: child.label.charAt(0).toUpperCase() + child.label.slice(1),
      href: `${base}${child.href}`,
    }));
  });
}

const navItems = flattenNav(site.navbar.items);

// ── Content index (built at build time; enables title/keyword search in dev too) ──
type SearchItem = { title: string; section: string; href: string; keywords: string };

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.hidden && !p.data.draft)
  .map((p): SearchItem => ({
    title: p.data.title,
    section: 'Blog',
    href: `${base}/blog/${p.id}/`,
    keywords: [...(p.data.tags ?? []), ...(p.data.categories ?? [])].join(' '),
  }));

const projects = (await getCollection('projects')).map((p): SearchItem => ({
  title: p.data.title,
  section: 'Research',
  href: `${base}/projects/${p.id}/`,
  keywords: p.data.category ?? '',
}));

const teaching = (await getCollection('teaching')).map((t): SearchItem => ({
  title: t.data.title,
  section: 'Courses',
  href: `${base}/teaching/`,
  keywords: t.data.term ?? '',
}));

// ── Publications — every paper is answerable by title, authors, venue, year ──
const publications = parseBibtex(bibRaw).map((entry): SearchItem => ({
  title: getTitle(entry),
  section: 'Publication',
  href: `${base}/publications/${entry.key}/`,
  keywords: [getAuthors(entry), getVenue(entry), String(getYear(entry) || ''), entry.fields.abbr ?? '']
    .filter(Boolean)
    .join(' '),
}));

// ── People — lab members answerable by name and role/interests ──
const peopleEntries = (await getCollection('people')).filter((p) => !p.data.noPage);

const people = peopleEntries.map((p): SearchItem => ({
  title: p.data.name,
  section: 'People',
  href: `${base}/people/${p.id}/`,
  keywords: [p.data.role ?? '', ...(p.data.interests ?? [])].join(' '),
}));

// Rich people facts — let the assistant answer "who is …" directly, not just link.
const peopleFacts = peopleEntries.map((p) => ({
  name: p.data.name,
  role: p.data.role ?? '',
  description: p.data.description ?? '',
  interests: p.data.interests ?? [],
  href: `${base}/people/${p.id}/`,
}));

const contentItems: SearchItem[] = [...publications, ...people, ...projects, ...posts, ...teaching];

// ── Lab facts — short direct answers for common "what/who is this lab" questions ──
const labFacts = {
  name: site.title ?? site.author.name,
  description: site.description ?? '',
  publicationCount: publications.length,
  peopleCount: people.length,
};

const logoIcon = `${base}/assets/img/cdl-logo-icon.png`;
const assistantName = 'CDL AI Assistant';
const welcomeHeading = `Welcome to ${assistantName}! How can I help you today?`;
const welcomeSub = `Ask me anything about the ${labFacts.name} — our people, publications, research, and courses.`;
const disclaimer = `${assistantName} is AI and can make mistakes. It only knows what's on this website.`;
---

<div
  id="site-assistant"
  data-nav-items={JSON.stringify(navItems)}
  data-content-items={JSON.stringify(contentItems)}
  data-people-facts={JSON.stringify(peopleFacts)}
  data-lab-facts={JSON.stringify(labFacts)}
  data-pagefind-base={base}
  data-email={site.author.email}
  data-author={site.author.name}
  data-name={assistantName}
  data-welcome-heading={welcomeHeading}
  data-welcome-sub={welcomeSub}
  data-disclaimer={disclaimer}
>
  <button id="assistant-toggle" aria-label="Open the site assistant" aria-expanded="false">
    <img src={logoIcon} alt="" class="assistant-toggle-logo" aria-hidden="true" width="512" height="512" />
  </button>

  <div id="assistant-overlay" hidden></div>

  <div id="assistant-panel" role="dialog" aria-label="Site assistant" aria-modal="true" hidden>
    <header id="assistant-head">
      <span id="assistant-title">
        <img src={logoIcon} alt="" class="assistant-title-logo" aria-hidden="true" width="512" height="512" />
        <span id="assistant-title-text"></span>
      </span>
      <button id="assistant-close" aria-label="Close the assistant">
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </header>

    <div id="assistant-body">
      <div id="assistant-hero">
        <div id="assistant-hero-badge" aria-hidden="true">
          <img src={logoIcon} alt="" width="512" height="512" />
        </div>
        <h2 id="assistant-hero-heading"></h2>
        <p id="assistant-hero-sub"></p>
      </div>

      <div id="assistant-log" aria-live="polite"></div>

      <div id="assistant-chips"></div>
    </div>

    <div id="assistant-footer">
      <form id="assistant-form" autocomplete="off">
        <input
          id="assistant-input"
          type="text"
          placeholder="Ask anything…"
          aria-label="Ask the site assistant"
        />
        <div id="assistant-controls">
          <div class="assistant-controls-left">
            <button type="button" id="assistant-attach" aria-label="Attach a file" title="File upload coming soon">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.44 11.05l-9.19 9.19a5 5 0 0 1-7.07-7.07l9.19-9.19a3 3 0 0 1 4.24 4.24l-9.2 9.19a1 1 0 0 1-1.41-1.41l8.49-8.49"></path>
              </svg>
            </button>
            <button type="button" id="assistant-new-thread">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14"></path>
              </svg>
              New Thread
            </button>
          </div>
          <div class="assistant-controls-right">
            <div class="assistant-mode-wrap">
              <select id="assistant-mode" aria-label="Answer mode">
                <option value="fast">Fast</option>
                <option value="detailed">Detailed</option>
              </select>
              <svg class="assistant-mode-caret" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
            <button type="submit" id="assistant-send" aria-label="Send message">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 19V5M5 12l7-7 7 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </form>
      <p id="assistant-disclaimer"></p>
    </div>
  </div>
</div>

<script>
  type NavItem = { label: string; href: string };
  type ContentItem = { title: string; section: string; href: string; keywords?: string };

  function initAssistant() {
    const root = document.getElementById('site-assistant');
    // transition:persist keeps this element alive across page swaps — only wire it once.
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const toggle = document.getElementById('assistant-toggle') as HTMLButtonElement;
    const overlay = document.getElementById('assistant-overlay') as HTMLElement;
    const panel = document.getElementById('assistant-panel') as HTMLElement;
    const closeBtn = document.getElementById('assistant-close') as HTMLButtonElement;
    const body = document.getElementById('assistant-body') as HTMLElement;
    const hero = document.getElementById('assistant-hero') as HTMLElement;
    const heroHeading = document.getElementById('assistant-hero-heading') as HTMLElement;
    const heroSub = document.getElementById('assistant-hero-sub') as HTMLElement;
    const log = document.getElementById('assistant-log') as HTMLElement;
    const chips = document.getElementById('assistant-chips') as HTMLElement;
    const form = document.getElementById('assistant-form') as HTMLFormElement;
    const input = document.getElementById('assistant-input') as HTMLInputElement;
    const titleText = document.getElementById('assistant-title-text') as HTMLElement;
    const disclaimerEl = document.getElementById('assistant-disclaimer') as HTMLElement;
    const newThreadBtn = document.getElementById('assistant-new-thread') as HTMLButtonElement;
    const attachBtn = document.getElementById('assistant-attach') as HTMLButtonElement;
    const modeSelect = document.getElementById('assistant-mode') as HTMLSelectElement;

    // "Fast" gives a couple of top hits; "Detailed" returns more related links.
    let mode: 'fast' | 'detailed' = 'fast';

    type PersonFact = {
      name: string;
      role: string;
      description: string;
      interests: string[];
      href: string;
    };

    const navItems: NavItem[] = JSON.parse(root.dataset.navItems ?? '[]');
    const contentItems: ContentItem[] = JSON.parse(root.dataset.contentItems ?? '[]');
    const peopleFacts: PersonFact[] = JSON.parse(root.dataset.peopleFacts ?? '[]');
    const labFacts: {
      name: string;
      description: string;
      publicationCount: number;
      peopleCount: number;
    } = JSON.parse(
      root.dataset.labFacts ?? '{"name":"","description":"","publicationCount":0,"peopleCount":0}',
    );
    const pagefindBase = root.dataset.pagefindBase ?? '';
    const email = root.dataset.email ?? '';
    const author = root.dataset.author ?? '';
    const assistantName = root.dataset.name ?? 'Assistant';
    const welcomeHeading = root.dataset.welcomeHeading ?? '';
    const welcomeSub = root.dataset.welcomeSub ?? '';
    const disclaimer = root.dataset.disclaimer ?? '';

    titleText.textContent = assistantName;
    heroHeading.textContent = welcomeHeading;
    heroSub.textContent = welcomeSub;
    disclaimerEl.textContent = disclaimer;

    let greeted = false;

    // Show the welcome hero while no messages exist; hide it once a chat starts.
    function startConversation() {
      hero.hidden = true;
      body.classList.add('is-chatting');
    }
    function resetToHero() {
      hero.hidden = false;
      body.classList.remove('is-chatting');
    }

    // ── Message bubbles (textContent only — never innerHTML with dynamic text) ──
    function addBubble(who: 'bot' | 'user', text: string, copyable = false): HTMLElement {
      const el = document.createElement('div');
      el.className = `assistant-msg assistant-msg--${who}`;

      const body = document.createElement('div');
      body.className = 'assistant-msg-text';
      body.textContent = text;
      el.appendChild(body);

      // A "Copy" action under substantive bot answers, like a real AI chat.
      if (who === 'bot' && copyable) {
        const actions = document.createElement('div');
        actions.className = 'assistant-msg-actions';
        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'assistant-copy';
        const label = document.createElement('span');
        label.textContent = 'Copy';
        copy.appendChild(label);
        copy.addEventListener('click', () => {
          navigator.clipboard?.writeText(text).then(() => {
            label.textContent = 'Copied';
            window.setTimeout(() => (label.textContent = 'Copy'), 1500);
          });
        });
        actions.appendChild(copy);
        el.appendChild(actions);
      }

      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    function addLinks(results: { title: string; section?: string; href: string }[]) {
      const wrap = document.createElement('div');
      wrap.className = 'assistant-msg assistant-msg--bot assistant-results';
      results.forEach((r) => {
        const a = document.createElement('a');
        a.className = 'assistant-result';
        a.href = r.href;
        const t = document.createElement('span');
        t.className = 'assistant-result-title';
        t.textContent = r.title;
        a.appendChild(t);
        if (r.section) {
          const s = document.createElement('span');
          s.className = 'assistant-result-section';
          s.textContent = r.section;
          a.appendChild(s);
        }
        wrap.appendChild(a);
      });
      log.appendChild(wrap);
      log.scrollTop = log.scrollHeight;
    }

    // ── Suggested prompts — click to ask, RadarAI-style ────────────────────────
    const suggestedPrompts = [
      `What is the ${labFacts.name}?`,
      'Who are the people in the lab?',
      'What research does the lab do?',
      'How can I contact the lab?',
    ];
    function renderChips() {
      chips.replaceChildren();
      suggestedPrompts.forEach((q) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'assistant-chip';
        b.textContent = q;
        b.addEventListener('click', () => {
          input.value = '';
          handleQuery(q);
        });
        chips.appendChild(b);
      });
    }

    // ── Pagefind (full-text, present after `yarn build`) with dev-mode fallback ──
    let pagefind: any = null;
    let pagefindTried = false;
    async function loadPagefind() {
      if (pagefindTried) return pagefind;
      pagefindTried = true;
      try {
        pagefind = await import(/* @vite-ignore */ `${pagefindBase}/pagefind/pagefind.js`);
        await pagefind.init();
      } catch {
        pagefind = null;
      }
      return pagefind;
    }

    // Question / filler words that shouldn't drive matching.
    const STOPWORDS = new Set([
      'a', 'an', 'the', 'is', 'are', 'was', 'were', 'do', 'does', 'did', 'of', 'in', 'on',
      'at', 'to', 'for', 'and', 'or', 'with', 'about', 'who', 'what', 'when', 'where', 'which',
      'how', 'why', 'me', 'i', 'you', 'your', 'my', 'can', 'could', 'would', 'tell', 'show',
      'find', 'give', 'any', 'some', 'there', 'their', 'have', 'has', 'this', 'that', 'from',
      'by', 'it', 'lab', 'cdl',
    ]);

    function tokenize(s: string): string[] {
      return (s.toLowerCase().match(/[a-z0-9]+/g) ?? []).filter((w) => !STOPWORDS.has(w));
    }

    // Token-scored search over the pre-built index (publications, people, projects,
    // posts, courses). Works identically in `yarn dev` and production.
    function localSearch(query: string) {
      const terms = tokenize(query);
      if (terms.length === 0) return [];
      return contentItems
        .map((c) => {
          const title = c.title.toLowerCase();
          const hay = `${title} ${(c.keywords ?? '').toLowerCase()}`;
          let score = 0;
          for (const t of terms) {
            if (title.includes(t)) score += 3; // title hits weigh most
            else if (hay.includes(t)) score += 1;
          }
          return { c, score };
        })
        .filter((x) => x.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 6)
        .map((x) => ({ title: x.c.title, href: x.c.href, section: x.c.section }));
    }

    // Find the lab member a query is asking about. Returns the best name match and
    // whether every word of their name appears in the query (a confident full match).
    function findPerson(query: string): { person: PersonFact; full: boolean } | null {
      const qTokens = new Set((query.toLowerCase().match(/[a-z0-9]+/g) ?? []));
      if (qTokens.size === 0) return null;
      let best: { person: PersonFact; matched: number; total: number } | null = null;
      for (const person of peopleFacts) {
        const nameTokens = (person.name.toLowerCase().match(/[a-z0-9]+/g) ?? []).filter(
          (t) => t.length >= 2,
        );
        if (nameTokens.length === 0) continue;
        const matched = nameTokens.filter((t) => qTokens.has(t));
        // Require a distinctive hit: a name word of 4+ chars present in the query.
        const distinctive = matched.some((t) => t.length >= 4);
        if (matched.length === 0 || !distinctive) continue;
        if (!best || matched.length > best.matched) {
          best = { person, matched: matched.length, total: nameTokens.length };
        }
      }
      if (!best) return null;
      return { person: best.person, full: best.matched >= best.total };
    }

    function answerPerson(p: PersonFact) {
      let msg = p.name;
      if (p.role) msg += ` — ${p.role}`;
      msg += '.';
      if (p.description) msg += ` ${p.description}`;
      if (p.interests.length) msg += ` Research interests: ${p.interests.join(', ')}.`;
      addBubble('bot', msg, true);
      addLinks([{ title: `${p.name}'s profile`, href: p.href, section: 'People' }]);
    }

    async function search(query: string) {
      const local = localSearch(query);

      // In production, Pagefind adds full-text page matches. Merge, de-duplicating by href.
      const pf = await loadPagefind();
      if (pf) {
        try {
          const response = await pf.search(tokenize(query).join(' ') || query);
          const data = await Promise.all(response.results.slice(0, 6).map((r: any) => r.data()));
          const seen = new Set(local.map((r) => r.href.replace(/\/$/, '')));
          for (const d of data) {
            const href = (d.url as string) ?? '';
            if (!href || seen.has(href.replace(/\/$/, ''))) continue;
            seen.add(href.replace(/\/$/, ''));
            local.push({ title: d.meta?.title || href, href, section: '' });
          }
        } catch {
          /* pagefind absent in dev — local results are enough */
        }
      }

      return local.slice(0, 8);
    }

    // Answer a single query.
    //  'answer'    → a real answer was given; offer a follow-up afterwards
    //  'smalltalk' → greeting/thanks/bye handled; no follow-up needed
    //  'none'      → nothing matched
    async function route(query: string): Promise<'answer' | 'smalltalk' | 'none'> {
      const cleaned = query
        .toLowerCase()
        .replace(/[^a-z\s]/g, '')
        .trim();

      // Small talk: greetings — just say hi back, don't run a search.
      if (
        /^(hi+|hey+|hello+|helo|yo+|hiya|howdy|sup|wassup|greetings|good\s?(morning|afternoon|evening|day))(\s?(there|everyone|assistant))?$/.test(
          cleaned,
        )
      ) {
        addBubble('bot', `Hello! How can I help you today?`);
        return 'smalltalk';
      }

      // Small talk: thanks.
      if (/^(thanks|thank\s?you|thx|ty|cheers|much appreciated|appreciate it)$/.test(cleaned)) {
        addBubble('bot', `You're welcome!`);
        return 'smalltalk';
      }

      // Small talk: goodbye.
      if (/^(bye+|goodbye|see\s?you|see ya|cya|take care|good night)$/.test(cleaned)) {
        addBubble('bot', `Goodbye! Come back anytime.`);
        return 'smalltalk';
      }

      // Small talk: how are you.
      if (/^(how are you|hows it going|how do you do|whats up)$/.test(cleaned)) {
        addBubble('bot', `I'm good, thanks! How can I help you today?`);
        return 'smalltalk';
      }

      // Intent: contact / how to reach the author.
      if (/\b(contact|email|e-?mail|reach|get in touch|message)\b/i.test(query) && email) {
        addBubble('bot', `You can reach ${author} by email:`);
        addLinks([{ title: email, href: `mailto:${email}`, section: 'Email' }]);
        return 'answer';
      }

      const navByLabel = (label: string) =>
        navItems.find((n) => n.label.toLowerCase() === label.toLowerCase());

      // Intent: a question about a specific lab member — answer directly.
      // Fires on a confident full-name match, or on any "who is / tell me about /
      // bio / profile" phrasing that also names someone in the lab.
      const asksAboutPerson = /\bwho\b|tell me about|\bbio\b|\bprofile\b|\bwork(s|ing)?\s+on\b/i.test(
        query,
      );
      const personMatch = findPerson(query);
      if (personMatch && (personMatch.full || asksAboutPerson)) {
        answerPerson(personMatch.person);
        return 'answer';
      }

      // Intent: what/who is the lab — describe it and point to About.
      if (/\b(what|who|tell|about|describe)\b/i.test(query) && /\b(lab|cdl|convergence|you|this|research)\b/i.test(query)) {
        if (labFacts.description) addBubble('bot', labFacts.description, true);
        const about = navByLabel('About') ?? navByLabel('Home');
        if (about) addLinks([{ title: about.label, href: about.href }]);
        return 'answer';
      }

      // Intent: how many publications / papers.
      if (/\bhow many\b/i.test(query) && /\b(publication|paper|pub)/i.test(query)) {
        addBubble('bot', `The lab lists ${labFacts.publicationCount} publications. Browse them all here:`);
        const pubs = navByLabel('Publications');
        if (pubs) addLinks([{ title: 'Publications', href: pubs.href }]);
        return 'answer';
      }

      // Intent: how many people / members.
      if (/\bhow many\b/i.test(query) && /\b(people|member|student|researcher)/i.test(query)) {
        addBubble('bot', `There are ${labFacts.peopleCount} people listed. Meet the team here:`);
        const ppl = navByLabel('People') ?? navByLabel('Team');
        if (ppl) addLinks([{ title: 'People', href: ppl.href }]);
        return 'answer';
      }

      const thinking = addBubble('bot', 'Looking…');
      const found = await search(query);
      thinking.remove();

      // Fast mode keeps it to the top few; Detailed surfaces more related links.
      const results = found.slice(0, mode === 'detailed' ? 8 : 4);
      if (results.length > 0) {
        const lead =
          mode === 'detailed'
            ? `Here's what I found for “${query}” — including related work:`
            : `Here's what I found for “${query}”:`;
        addBubble('bot', lead);
        addLinks(results);
        return 'answer';
      }

      addBubble(
        'bot',
        `Sorry, I don't have information about that. I can only answer questions about the Convergence Design Lab — our people, publications, research projects, and courses. Try rephrasing your question.`,
      );
      return 'none';
    }

    async function handleQuery(raw: string) {
      const query = raw.trim();
      if (!query) return;
      // The first question swaps the welcome hero out for the chat transcript.
      startConversation();
      addBubble('user', query);
      // Once the visitor starts asking, drop the suggested prompts so each answer
      // stands on its own instead of repeating "About / Research / People…".
      chips.replaceChildren();

      const status = await route(query);
      if (status === 'answer') {
        addBubble('bot', 'Is there anything else I can help you with?');
      }
    }

    // ── Open / close ───────────────────────────────────────────────────────────
    function open() {
      overlay.hidden = false;
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      root?.classList.add('is-open');
      if (!greeted) {
        greeted = true;
        renderChips();
      }
      window.setTimeout(() => input.focus(), 60);
    }

    function close() {
      overlay.hidden = true;
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      root?.classList.remove('is-open');
      // Reset the whole conversation, so reopening the assistant starts fresh
      // with just the welcome hero and the suggested prompts again.
      log.replaceChildren();
      chips.replaceChildren();
      input.value = '';
      greeted = false;
      resetToHero();
    }

    toggle.addEventListener('click', () => (panel.hidden ? open() : close()));
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', close);
    // Navbar "CDL AI" button (and any other launcher) opens the assistant.
    window.addEventListener('assistant:open', () => {
      if (panel.hidden) open();
      else window.setTimeout(() => input.focus(), 30);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = input.value;
      input.value = '';
      handleQuery(value);
    });

    // "New Thread" — wipe the transcript and return to the welcome screen.
    newThreadBtn.addEventListener('click', () => {
      log.replaceChildren();
      input.value = '';
      resetToHero();
      renderChips();
      input.focus();
    });

    // Answer mode selector (Fast / Detailed).
    modeSelect.addEventListener('change', () => {
      mode = modeSelect.value === 'detailed' ? 'detailed' : 'fast';
    });

    // File upload isn't wired to a backend — be upfront instead of failing silently.
    attachBtn.addEventListener('click', () => {
      startConversation();
      chips.replaceChildren();
      addBubble(
        'bot',
        `File and image uploads aren't available on this site yet — but you can ask me anything about the ${labFacts.name} in text.`,
      );
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });
  }

  initAssistant();
  document.addEventListener('astro:after-swap', initAssistant);
</script>


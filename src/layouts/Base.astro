---
import '@styles/global.css';

import Assistant from '@components/assistant/Assistant.astro';
import Footer from '@components/Footer.astro';
import Navbar from '@components/Navbar.astro';
import SearchTrigger from '@components/search/SearchTrigger.astro';
import { site } from '@config/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  /** OG preview image (absolute URL or path) */
  image?: string;
  noindex?: boolean;
  /** Override the robots meta tag content string (e.g. 'noindex, nofollow'). */
  robots?: string;
  /** Whether this is the homepage — injects Person JSON-LD when true */
  isHome?: boolean;
}

const {
  title = site.author.name,
  description = site.description,
  image = site.og.image || undefined,
  noindex = false,
  robots,
  isHome = false,
} = Astro.props;

const pageTitle = title === site.author.name ? title : `${title} | ${site.author.name}`;
const canonicalURL = new URL(Astro.url.pathname, site.url);
// Prepend base path to root-relative images before resolving to absolute URL
const resolvedImage = image?.startsWith('/')
  ? `${import.meta.env.BASE_URL}${image.slice(1)}`
  : image;
const ogImage = resolvedImage ? new URL(resolvedImage, site.url).toString() : undefined;

// Theme color override — only injected when site.theme.color is not 'auto'
const lightColor = site.theme.color.light === 'auto' ? null : site.theme.color.light;
const darkColor = site.theme.color.dark === 'auto' ? null : site.theme.color.dark;
const colorOverrideStyle = [
  lightColor
    ? `:root,[data-theme='light']{--global-theme-color:${lightColor};--global-hover-color:${lightColor};}`
    : '',
  darkColor
    ? `[data-theme='dark']{--global-theme-color:${darkColor};--global-hover-color:${darkColor};}`
    : '',
]
  .filter(Boolean)
  .join('');

// Intro curtain script (homepage only). Kept as a raw string and injected via
// `set:html` so the browser receives it verbatim — an `is:inline` script whose
// children contain a JSX template literal gets emitted as literal text and
// never executes. Drives the 0→100% counter, then wipes the curtain. Fast
// (~1.2s) with a hard 2.2s failsafe so it can NEVER get stuck on screen.
const introScript = `
(function () {
  var html = document.documentElement;
  var intro = document.getElementById('cdl-intro');
  if (!intro || html.classList.contains('intro-done')) return;
  var countEl = intro.querySelector('.cdl-intro-count');
  var prevOverflow = html.style.overflow;
  html.style.overflow = 'hidden';

  var finished = false;
  function finish() {
    if (finished) return;
    finished = true;
    if (countEl) countEl.textContent = '100%';
    intro.classList.add('is-out');
    html.style.overflow = prevOverflow || '';
    function done() {
      html.classList.add('intro-done');
      if (intro && intro.parentNode) intro.remove();
    }
    intro.addEventListener('transitionend', done, { once: true });
    setTimeout(done, 700);
  }

  // Progress-driven counter (0 → 100%) over ~1.2s.
  var DUR = 1200;
  var start = performance.now();
  function tick(now) {
    if (finished) return;
    var t = Math.min((now - start) / DUR, 1);
    if (countEl) countEl.textContent = Math.round(t * 100) + '%';
    if (t < 1) requestAnimationFrame(tick);
    else finish();
  }
  requestAnimationFrame(tick);

  // Layered safety nets — the curtain can NEVER get stuck on screen:
  //  1) hard timeout, fires even if rAF is throttled (e.g. background tab)
  //  2) window 'load', in case something delayed first paint
  //  3) a click / key / touch anywhere skips straight to the site
  setTimeout(finish, 2200);
  window.addEventListener('load', function () { setTimeout(finish, 1500); });
  ['pointerdown', 'keydown', 'touchstart', 'wheel'].forEach(function (ev) {
    window.addEventListener(ev, finish, { once: true, passive: true });
  });
})();
`;

// Person JSON-LD for homepage — helps search engines associate content with the author
const personJsonLd = isHome ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author.name,
  url: site.url,
  email: site.author.email || undefined,
  sameAs: [
    site.socials.orcid_id ? `https://orcid.org/${site.socials.orcid_id}` : null,
    site.socials.scholar_userid ? `https://scholar.google.com/citations?user=${site.socials.scholar_userid}` : null,
    site.socials.github_username ? `https://github.com/${site.socials.github_username}` : null,
  ].filter(Boolean),
}) : null;
---

<!doctype html>
<html lang={site.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {(robots || noindex) && <meta name="robots" content={robots ?? 'noindex, nofollow'} />}

    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    <!--
      Favicon — a round, transparent-cornered crop of the logo. The full logo is
      a line drawing on an opaque white square with wide padding, which at 16px
      reads as a white box with a smudge in it rather than as the mark.
    -->
    <link rel="icon" href={`${site.base}/favicon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${site.base}/apple-touch-icon.png`} />

    <!-- Fonts are self-hosted via Fontsource (imported in global.css) — no FOUT -->

    <!-- KaTeX CSS is bundled via global.css (@import 'katex/dist/katex.min.css') -->

    <!-- Theme color override (from site.theme.color — 'auto' means use _colors.css defaults) -->
    {colorOverrideStyle && <Fragment set:html={`<style>${colorOverrideStyle}</style>`} />}

    <!-- Open Graph + Twitter Card -->
    {
      site.og.enabled && (
        <>
          <meta property="og:title" content={pageTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalURL} />
          <meta property="og:type" content="website" />
          {ogImage && <meta property="og:image" content={ogImage} />}
          <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
          <meta name="twitter:title" content={pageTitle} />
          <meta name="twitter:description" content={description} />
          {ogImage && <meta name="twitter:image" content={ogImage} />}
          {site.socials.x_username && <meta name="twitter:site" content={`@${site.socials.x_username}`} />}
        </>
      )
    }

    <!-- Analytics verification tags -->
    {
      site.analytics.googleVerification && (
        <meta name="google-site-verification" content={site.analytics.googleVerification} />
      )
    }
    {
      site.analytics.bingVerification && (
        <meta name="msvalidate.01" content={site.analytics.bingVerification} />
      )
    }

    <!-- GA4 via Partytown (production only) -->
    {
      import.meta.env.PROD && site.analytics.ga4 && (
        <>
          <script
            type="text/partytown"
            src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.ga4}`}
          />
          <script type="text/partytown" define:vars={{ ga4: site.analytics.ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', ga4);
          </script>
        </>
      )
    }

    <!-- Cronitor RUM -->
    {
      import.meta.env.PROD && site.analytics.cronitor && (
        <script
          define:vars={{ siteId: site.analytics.cronitor }}
          is:inline
        >{`!function(p,a,t,h,w,n,k){p.cronitor||(p.cronitor=function(){(p.cronitor.q=p.cronitor.q||[]).push(arguments)}),h=a.getElementsByTagName("script")[0],(k=a.createElement("script")).setAttribute("async",!0),k.setAttribute("src","https://rum.cronitor.io/script.js"),k.setAttribute("data-site-id",siteId),h.parentNode.insertBefore(k,h)}(window,document);`}</script>
      )
    }

    <!-- Pirsch analytics -->
    {
      import.meta.env.PROD && site.analytics.pirsch && (
        <script
          defer
          src="https://api.pirsch.io/pa.js"
          id="pianjs"
          data-code={site.analytics.pirsch}
        ></script>
      )
    }

    <!-- OpenPanel analytics -->
    {
      import.meta.env.PROD && site.analytics.openpanel && (
        <script
          define:vars={{ clientId: site.analytics.openpanel }}
          is:inline
        >{`(function(w,d,s){var c=d.createElement(s);c.src="https://openpanel.dev/op1.js";c.defer=true;c.setAttribute("data-client-id",clientId);d.head.appendChild(c);})(window,document,"script");`}</script>
      )
    }

    <!-- Person JSON-LD (homepage only) -->
    {personJsonLd && <script type="application/ld+json" set:html={personJsonLd} />}

    <!-- View Transitions (smooth page-to-page navigation) -->
    {site.features.viewTransitions && <ClientRouter />}

    <!-- Named slot for page-specific head content (e.g. JSON-LD from Post.astro) -->
    <slot name="head" />

    <!--
      Dark mode: must run BEFORE any CSS to prevent FOUC.
      Reads stored preference, falls back to system preference, then site default.
      Re-applies after each View Transition swap to keep the theme consistent.
    -->
    <script is:inline define:vars={{ defaultTheme: site.theme.default }}>
      function applyTheme() {
        const stored = localStorage.getItem('theme');
        let theme;
        if (stored === 'light' || stored === 'dark') {
          theme = stored;
        } else if (defaultTheme === 'system') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        } else {
          theme = defaultTheme;
        }
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-theme-setting', stored || 'system');
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);

      // Safety: never carry the intro's scroll-lock into another page. If the
      // visitor clicks a link while the homepage intro is still up, releasing
      // the lock here keeps the next page fully scrollable (not "stuck").
      function releaseScrollLock() {
        document.documentElement.style.overflow = '';
      }
      document.addEventListener('astro:before-swap', releaseScrollLock);
      document.addEventListener('astro:after-swap', releaseScrollLock);

      // Critical anti-stuck fix: with view transitions, navigating back to the
      // homepage re-inserts the intro overlay markup, but its inline script can
      // NOT re-run (browsers don't execute scripts inserted during a swap). That
      // would leave the loading curtain frozen on screen forever. So after every
      // in-site navigation, forcibly remove any intro overlay and unlock scroll —
      // the intro is only meant to play on a true first page load, never on SPA
      // navigation.
      function killIntroOverlay() {
        var intro = document.getElementById('cdl-intro');
        if (intro && intro.parentNode) intro.remove();
        document.documentElement.style.overflow = '';
      }
      document.addEventListener('astro:after-swap', killIntroOverlay);
    </script>

    <!--
      Intro curtain gate: decide BEFORE first paint whether to show the
      spinning-monogram intro. It plays on every full page load / reload of the
      HOMEPAGE only, but NOT with reduced motion. (During in-site click
      navigation the script keeps `intro-done` on <html> for that page's
      lifetime, so the curtain only shows on real loads — see the intro script
      below.)
    -->
    {isHome && (
      <script is:inline>
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('intro-done');
          }
        } catch (e) {
          /* matchMedia unavailable — let the intro play */
        }
      </script>
    )}

    <!--
      Netlify Identity widget: catches the invite/recovery link from the email
      the professor receives, then bounces them into the /admin/ editor. Harmless
      when Identity is not enabled — it simply does nothing.
    -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" is:inline></script>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          if (!user) {
            window.netlifyIdentity.on('login', () => {
              document.location.href = '/admin/';
            });
          }
        });
      }
    </script>
  </head>

  <body
    class="min-h-screen flex flex-col"
    style="padding-top: var(--navbar-height);"
    data-footer-position={site.footer.position}
    data-tooltips={site.features.tooltips ? 'true' : undefined}
  >
    <!-- Custom cursor (decorative, non-interactive): reacts to interactive
         elements. Hidden on touch and disabled for reduced motion.
         The film-grain overlay was removed — a full-viewport noise layer
         repainting every 0.6s forever cost more than it added. -->
    <div class="fx-cursor-ring" aria-hidden="true"></div>
    <div class="fx-cursor-dot" aria-hidden="true"></div>

    <!-- Intro curtain: the lab monogram (circle + hexagon line art spinning in
         3D, hand static in the centre — an exact replica of the hero mark)
         pops in with a 0→100% counter, then the curtain wipes away to reveal
         the site. Homepage only. -->
    {isHome && (
      <div id="cdl-intro" aria-hidden="true">
        <div class="cdl-intro-mark">
          <svg class="cdl-intro-circle" viewBox="0 0 200 200" aria-hidden="true">
            <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="3" />
          </svg>
          <svg class="cdl-intro-hex" viewBox="0 0 200 200" aria-hidden="true">
            <polygon
              points="100,16 173,58 173,142 100,184 27,142 27,58"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />
          </svg>
          <img
            class="cdl-intro-hand"
            src={`${site.base}/assets/img/cdl-hand-only.png`}
            alt=""
            width="325"
            height="325"
          />
        </div>
        <span class="cdl-intro-count">0%</span>
      </div>
    )}

    <!-- Skip to main content (accessibility) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 px-4 py-2 rounded"
      style="background-color: var(--global-theme-color); color: var(--global-hover-text-color);"
    >
      Skip to main content
    </a>

    <Navbar />

    <!-- ⌘K Search (ninja-keys + Pagefind) — persisted across View Transitions -->
    {site.features.search && <SearchTrigger transition:persist />}

    <main id="main-content" class="flex-1" data-pagefind-body>
      <slot />
    </main>

    <!-- Newsletter (shown in footer area if enabled) -->
    {site.features.newsletter && <slot name="newsletter" />}

    {site.footer.position !== 'hidden' && <Footer />}

    <!-- Cookie consent (vanilla-cookieconsent via CDN) -->
    {
      site.features.cookieConsent && (
        <>
          <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.0.1/dist/cookieconsent.css"
          />
          <script
            src="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.0.1/dist/cookieconsent.umd.js"
            defer
          ></script>
          <script is:inline>{`
            window.addEventListener('load', function() {
              if (typeof CookieConsent === 'undefined') return;
              CookieConsent.run({
                categories: {
                  necessary: { enabled: true, readOnly: true },
                  analytics: {}
                },
                language: {
                  default: 'en',
                  translations: {
                    en: {
                      consentModal: {
                        title: 'We use cookies',
                        description: 'This site uses cookies to improve your experience and analyze traffic.',
                        acceptAllBtn: 'Accept all',
                        acceptNecessaryBtn: 'Reject all',
                        showPreferencesBtn: 'Manage preferences'
                      },
                      preferencesModal: {
                        title: 'Cookie preferences',
                        acceptAllBtn: 'Accept all',
                        acceptNecessaryBtn: 'Reject all',
                        savePreferencesBtn: 'Save preferences',
                        sections: [
                          { title: 'Necessary cookies', description: 'Required for the site to function.', linkedCategory: 'necessary' },
                          { title: 'Analytics cookies', description: 'Help us understand how visitors interact with the site.', linkedCategory: 'analytics' }
                        ]
                      }
                    }
                  }
                }
              });
            });
          `}</script>
        </>
      )
    }

    <!-- Floating site assistant (client-side, reuses Pagefind search) -->
    {site.features.assistant && <Assistant transition:persist />}

    <!-- Scroll progress indicator (fills as the page scrolls) -->
    <div id="scroll-progress" aria-hidden="true"></div>

    <!-- Back to top button -->
    <button id="back-to-top" aria-label="Back to top" title="Back to top" data-magnetic>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m18 15-6-6-6 6"></path>
      </svg>
    </button>

    <script>
      let btn = document.getElementById('back-to-top');

      function updateVisibility() {
        btn?.classList.toggle('visible', window.scrollY > 300);
      }

      function attachClick() {
        btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }

      window.addEventListener('scroll', updateVisibility, { passive: true });
      attachClick();

      // After each View Transition the DOM is swapped — re-query the new element,
      // re-attach the click handler, and re-evaluate visibility immediately
      // (the scroll event doesn't fire when the browser resets scroll position).
      document.addEventListener('astro:after-swap', () => {
        btn = document.getElementById('back-to-top');
        attachClick();
        updateVisibility();
      });
    </script>

    <!-- Micro-interactions: scroll reveal, count-up stats, navbar elevation -->
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Gate the hidden pre-reveal state on this class so content stays
      // visible if this script never runs (see _effects.css).
      document.documentElement.classList.add('js-reveal');

      let fxController: AbortController | null = null;

      function animateCount(el: HTMLElement): void {
        const target = parseInt(el.dataset.countup ?? '0', 10);
        const suffix = el.dataset.suffix ?? '';
        if (reduceMotion || !Number.isFinite(target)) {
          el.textContent = `${target}${suffix}`;
          return;
        }
        const duration = 1300;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = `${Math.round(eased * target)}${suffix}`;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      function initEffects(): void {
        fxController?.abort();
        fxController = new AbortController();
        const { signal } = fxController;

        // ── Reveal on scroll + count-up numbers ─────────────────────────
        // Plain rect checks on scroll instead of IntersectionObserver:
        // a handful of elements per page, and it degrades gracefully in
        // embedded/throttled browsers where IO callbacks never fire.
        function sweep(): void {
          const vh = window.innerHeight;

          document.querySelectorAll('[data-reveal]:not(.revealed)').forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.top < vh - 40 && r.bottom > 0) el.classList.add('revealed');
          });

          document
            .querySelectorAll<HTMLElement>('[data-countup]:not([data-counted])')
            .forEach((el) => {
              const r = el.getBoundingClientRect();
              if (r.top < vh && r.bottom > 0) {
                el.setAttribute('data-counted', 'true');
                animateCount(el);
              }
            });
        }

        if (reduceMotion) {
          document
            .querySelectorAll('[data-reveal]')
            .forEach((el) => el.classList.add('revealed'));
          document
            .querySelectorAll<HTMLElement>('[data-countup]:not([data-counted])')
            .forEach((el) => {
              el.setAttribute('data-counted', 'true');
              animateCount(el);
            });
        } else {
          window.addEventListener('scroll', sweep, { passive: true, signal });
          window.addEventListener('resize', sweep, { passive: true, signal });
          sweep();
        }

        // ── Navbar shadow once scrolled ─────────────────────────────────
        const nav = document.querySelector('.navbar');
        const elevate = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
        window.addEventListener('scroll', elevate, { passive: true, signal });
        elevate();

        // ── Scroll progress bar ─────────────────────────────────────────
        const progress = document.getElementById('scroll-progress');
        if (progress) {
          const setProgress = () => {
            const doc = document.documentElement;
            const max = doc.scrollHeight - doc.clientHeight;
            const p = max > 0 ? doc.scrollTop / max : 0;
            progress.style.transform = `scaleX(${p})`;
          };
          window.addEventListener('scroll', setProgress, { passive: true, signal });
          window.addEventListener('resize', setProgress, { passive: true, signal });
          setProgress();
        }

        if (!reduceMotion) {
          // ── Pointer spotlight glow on cards ───────────────────────────
          // Writes are batched into one animation frame: a raw pointermove
          // handler fires far more often than the screen refreshes, and each
          // custom-property write repaints the card's gradient.
          document
            .querySelectorAll<HTMLElement>(
              '.stat-item, .stat-tile, .course-item, .person-card, .card.hoverable'
            )
            .forEach((card) => {
              card.setAttribute('data-spotlight', '');
              let sraf = 0;
              let sx = 0;
              let sy = 0;
              card.addEventListener(
                'pointermove',
                (e) => {
                  sx = e.clientX;
                  sy = e.clientY;
                  if (sraf) return;
                  sraf = requestAnimationFrame(() => {
                    sraf = 0;
                    const r = card.getBoundingClientRect();
                    card.style.setProperty('--mx', `${sx - r.left}px`);
                    card.style.setProperty('--my', `${sy - r.top}px`);
                  });
                },
                { passive: true, signal }
              );
            });

          // ── 3D tilt on cards (site-wide depth) ────────────────────────
          // Each card leans in 3D toward the cursor: rotateX/rotateY around
          // its centre with a perspective, plus a small translateZ pop, so
          // the whole site reads as layered/3D. Fine-pointer only, so touch
          // devices never get a stuck tilt (pointerleave is unreliable there).
          if (window.matchMedia('(pointer: fine)').matches) {
            const TILT_MAX = 7; // degrees
            document
              .querySelectorAll<HTMLElement>(
                '.stat-item, .stat-tile, .course-item, .person-card, .card.hoverable'
              )
              .forEach((card) => {
                card.style.transformStyle = 'preserve-3d';
                card.addEventListener(
                  'pointermove',
                  (e) => {
                    const r = card.getBoundingClientRect();
                    const px = (e.clientX - r.left) / r.width - 0.5; // -0.5..0.5
                    const py = (e.clientY - r.top) / r.height - 0.5;
                    card.style.transition = 'none';
                    card.style.transform =
                      `perspective(800px) rotateX(${(-py * TILT_MAX).toFixed(2)}deg) ` +
                      `rotateY(${(px * TILT_MAX).toFixed(2)}deg) translateZ(6px)`;
                  },
                  { signal }
                );
                card.addEventListener(
                  'pointerleave',
                  () => {
                    card.style.transition =
                      'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
                    card.style.transform = '';
                  },
                  { signal }
                );
              });
          }

          // ── Magnetic buttons (lean toward the cursor) ─────────────────
          document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
            const strength = 0.3;
            el.addEventListener(
              'pointermove',
              (e) => {
                const r = el.getBoundingClientRect();
                const x = e.clientX - (r.left + r.width / 2);
                const y = e.clientY - (r.top + r.height / 2);
                el.style.transform = `translate(${x * strength}px, ${y * strength}px)`;
              },
              { signal }
            );
            el.addEventListener(
              'pointerleave',
              () => {
                el.style.transform = '';
              },
              { signal }
            );
          });

          // ── Hero depth: SMOOTH mouse parallax (lerp toward target) ────
          // A continuous rAF loop eases the layers toward the pointer target
          // instead of snapping each frame, so motion feels buttery, not
          // stepped. The loop parks itself once it has settled.
          const hero = document.querySelector<HTMLElement>('.hero-bleed');
          if (hero) {
            const layers = (
              [
                ['.geo-frame', 26],
                ['.side-rail-left', 15],
                ['.side-rail-right', 15],
              ] as const
            )
              .map(([sel, depth]) => ({ el: hero.querySelector<HTMLElement>(sel), depth }))
              .filter((l): l is { el: HTMLElement; depth: number } => l.el !== null);

            let curX = 0;
            let curY = 0;
            let tgtX = 0;
            let tgtY = 0;
            let running = false;
            const tick = () => {
              curX += (tgtX - curX) * 0.09;
              curY += (tgtY - curY) * 0.09;
              for (const { el, depth } of layers) {
                el.style.transform = `translate3d(${(-curX * depth).toFixed(2)}px, ${(-curY * depth).toFixed(2)}px, 0)`;
              }
              if (Math.abs(tgtX - curX) > 0.0004 || Math.abs(tgtY - curY) > 0.0004) {
                requestAnimationFrame(tick);
              } else {
                running = false;
              }
            };
            const kick = () => {
              if (!running) {
                running = true;
                requestAnimationFrame(tick);
              }
            };
            hero.addEventListener(
              'pointermove',
              (e) => {
                const r = hero.getBoundingClientRect();
                tgtX = (e.clientX - (r.left + r.width / 2)) / r.width;
                tgtY = (e.clientY - (r.top + r.height / 2)) / r.height;
                kick();
              },
              { signal }
            );
            hero.addEventListener(
              'pointerleave',
              () => {
                tgtX = 0;
                tgtY = 0;
                kick();
              },
              { signal }
            );

            // ── Scroll dissolve: hero content recedes as you scroll ─────
            const heroContent = hero.querySelector<HTMLElement>('.hero-content');
            if (heroContent) {
              const dissolve = () => {
                const h = hero.offsetHeight || 1;
                const p = Math.min(Math.max(window.scrollY / h, 0), 1);
                heroContent.style.opacity = String(1 - p * 0.85);
                heroContent.style.transform = `translateY(${(p * 30).toFixed(1)}px) scale(${(1 - p * 0.03).toFixed(3)})`;
              };
              window.addEventListener('scroll', dissolve, { passive: true, signal });
              dissolve();
            }
          }

          // ── Scroll focus: content "bubbles up" through a focal band ────
          // As a block rises toward the focal line it scales up (bigger than
          // its neighbours), sharpens and brightens; as it leaves the band it
          // eases back, softens and blurs — a depth-of-field feel.
          // Applies to project cards (.col), news items and publication rows.
          // People pages opt OUT via [data-no-focus] so they never blur.
          const FOCUS_SELECTOR =
            '.two-col-section, .stats-bar, .col, .news-item, .publications ol.bibliography > li';
          let focusEls: HTMLElement[] = [];
          const collectFocus = () => {
            focusEls = Array.from(
              document.querySelectorAll<HTMLElement>(FOCUS_SELECTOR)
            ).filter((el) => !el.closest('[data-no-focus]'));
          };
          collectFocus();

          let focusRaf = 0;
          const applyFocus = () => {
            focusRaf = 0;
            if (!focusEls.length) return;
            const vh = window.innerHeight;
            const focal = vh * 0.46;
            const range = vh * 0.62;
            // How much scroll is left in the document. The last blocks on a
            // page can never rise to the focal line — the page runs out of
            // scroll first — so without this they'd stay stuck blurred and
            // faded at the bottom. We subtract that unavoidable shortfall
            // below so they resolve fully sharp as you reach the end.
            const remaining = Math.max(
              0,
              document.documentElement.scrollHeight - (window.scrollY + vh)
            );
            for (const el of focusEls) {
              // Let the one-time entrance reveal finish before we take over.
              if (el.hasAttribute('data-reveal') && !el.classList.contains('revealed')) {
                continue;
              }
              // Publication rows animate in via .pub-reveal → .pub-in; wait.
              if (el.classList.contains('pub-reveal') && !el.classList.contains('pub-in')) {
                continue;
              }
              const r = el.getBoundingClientRect();
              if (r.bottom < -60 || r.top > vh + 60) {
                if (el.dataset.foff !== '1') {
                  el.style.transform = '';
                  el.style.opacity = '';
                  el.style.filter = '';
                  el.dataset.foff = '1';
                }
                continue;
              }
              el.dataset.foff = '0';
              const center = r.top + r.height / 2;
              // The closest this block will ever get to the focal line, given
              // the scroll that's actually left. For blocks near the end of
              // the document that shortfall is unavoidable, so discount it —
              // otherwise the final row is permanently out of focus.
              const shortfall = Math.max(0, center - remaining - focal);
              let d = Math.min(
                Math.max(Math.abs(center - focal) - shortfall, 0) / range,
                1
              );
              // Publications: keep a band of ~2 rows fully sharp before the
              // blur ramps in, instead of only a single row being in focus.
              if (el.closest('.publications')) {
                const PLATEAU = 0.42;
                d = d <= PLATEAU ? 0 : (d - PLATEAU) / (1 - PLATEAU);
              }
              const eased = d * d * (3 - 2 * d); // smoothstep
              el.style.transform = `scale(${(1.015 - eased * 0.05).toFixed(3)})`;
              el.style.opacity = (1 - eased * 0.32).toFixed(3);
              el.style.filter = `blur(${(eased * 2.2).toFixed(2)}px)`;
            }
          };
          const scheduleFocus = () => {
            if (!focusRaf) focusRaf = requestAnimationFrame(applyFocus);
          };
          window.addEventListener('scroll', scheduleFocus, { passive: true, signal });
          window.addEventListener('resize', scheduleFocus, { passive: true, signal });
          // Publications render their list client-side (React), so expose a
          // hook the page calls once rows exist to fold them into the system.
          (window as unknown as { __cdlFocusRescan?: () => void }).__cdlFocusRescan =
            () => {
              collectFocus();
              scheduleFocus();
            };
          applyFocus();
        }
      }

      initEffects();
      document.addEventListener('astro:after-swap', initEffects);
    </script>

    <script>
      // ── Custom cursor + magnetic elements ────────────────────────────────
      // Only runs on fine pointers (mouse/trackpad) with motion allowed. The
      // dot snaps to the pointer; the ring eases behind it and swells over
      // interactive targets. Magnetic elements pull gently toward the cursor.
      const finePointer = window.matchMedia('(pointer: fine)').matches;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (finePointer && !reduce) {
        const html = document.documentElement;
        const dot = document.querySelector<HTMLElement>('.fx-cursor-dot');
        const ring = document.querySelector<HTMLElement>('.fx-cursor-ring');

        if (dot && ring) {
          html.classList.add('fx-cursor-on');

          let mx = window.innerWidth / 2;
          let my = window.innerHeight / 2;
          let rx = mx;
          let ry = my;

          window.addEventListener(
            'pointermove',
            (e) => {
              mx = e.clientX;
              my = e.clientY;
              dot.style.transform = `translate3d(${mx}px, ${my}px, 0) translate(-50%, -50%)`;
            },
            { passive: true },
          );

          const raf = () => {
            rx += (mx - rx) * 0.18;
            ry += (my - ry) * 0.18;
            ring.style.transform = `translate3d(${rx}px, ${ry}px, 0) translate(-50%, -50%)`;
            requestAnimationFrame(raf);
          };
          requestAnimationFrame(raf);

          window.addEventListener('pointerdown', () => html.classList.add('fx-cursor-down'));
          window.addEventListener('pointerup', () => html.classList.remove('fx-cursor-down'));

          const HOT = 'a, button, [data-href], .magnetic, input, textarea, select, summary';
          document.addEventListener('pointerover', (e) => {
            if ((e.target as Element)?.closest?.(HOT)) html.classList.add('fx-cursor-hot');
          });
          document.addEventListener('pointerout', (e) => {
            if ((e.target as Element)?.closest?.(HOT)) html.classList.remove('fx-cursor-hot');
          });
        }

        // Magnetic pull for buttons, nav links, and anything tagged .magnetic.
        function initMagnetic(): void {
          const targets = document.querySelectorAll<HTMLElement>(
            '.magnetic, .navbar a, .btn, .col-tag-link, .col-more',
          );
          targets.forEach((el) => {
            if (el.dataset.magneticBound === '1') return;
            el.dataset.magneticBound = '1';
            const strength = 0.35;
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              const x = (e.clientX - (r.left + r.width / 2)) * strength;
              const y = (e.clientY - (r.top + r.height / 2)) * strength;
              el.style.transform = `translate(${x}px, ${y}px)`;
            });
            el.addEventListener('pointerleave', () => {
              el.style.transform = '';
            });
          });
        }
        initMagnetic();
        document.addEventListener('astro:after-swap', initMagnetic);
      }
    </script>

    {isHome && <script is:inline set:html={introScript} />}
  </body>
</html>
